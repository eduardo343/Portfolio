---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
	<nav class="site-nav">
		<div class="brand-wrap">
			<a href="/" class="brand">{SITE_TITLE}</a>
		</div>

		<div class="internal-links">
			<HeaderLink href="/" class="site-link" data-i18n="header.home">Home</HeaderLink>
			<HeaderLink href="/blog" class="site-link" data-i18n="header.projects">Projects</HeaderLink>
			<HeaderLink href="/about" class="site-link" data-i18n="header.about">About</HeaderLink>
			<HeaderLink href="/contact" class="site-link" data-i18n="header.contact">Contact</HeaderLink>
		</div>

		<div class="social-links">
			<a href="https://www.twitch.tv/malan117" target="_blank" rel="noopener noreferrer" class="social-link">
				<span class="sr-only" data-i18n="header.social.twitch">Follow me on Twitch</span>
				TW
			</a>
			<a href="https://www.linkedin.com/in/alan-ugarte/" target="_blank" rel="noopener noreferrer" class="social-link">
				<span class="sr-only" data-i18n="header.social.linkedin">Connect with me on LinkedIn</span>
				IN
			</a>
			<a href="https://github.com/eduardo343" target="_blank" rel="noopener noreferrer" class="social-link">
				<span class="sr-only" data-i18n="header.social.github">Go to GitHub repo</span>
				GH
			</a>
		</div>
	</nav>
</header>

<script is:inline>
	(() => {
		const root = document.querySelector('.site-header');
		const languageApi = window.portfolioLanguage;
		if (!root || !languageApi) return;

		const translations = {
			es: {
				'header.home': 'Inicio',
				'header.projects': 'Proyectos',
				'header.about': 'Sobre mi',
				'header.contact': 'Contacto',
				'header.social.twitch': 'Sigueme en Twitch',
				'header.social.linkedin': 'Conecta conmigo en LinkedIn',
				'header.social.github': 'Ir al repositorio de GitHub'
			},
			en: {
				'header.home': 'Home',
				'header.projects': 'Projects',
				'header.about': 'About',
				'header.contact': 'Contact',
				'header.social.twitch': 'Follow me on Twitch',
				'header.social.linkedin': 'Connect with me on LinkedIn',
				'header.social.github': 'Go to GitHub repo'
			}
		};

		const activeLang = languageApi.getLang();
		const currentMessages = languageApi.captureTranslations?.(root) || {};
		translations[activeLang] = {
			...(translations[activeLang] || {}),
			...currentMessages
		};

		const render = (lang) => {
			languageApi.applyTranslations(root, translations, lang);
		};

		render(activeLang);
		window.addEventListener('portfolio-lang-change', (event) => {
			render(event.detail);
		});
	})();
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(0, 0, 0, 0.9);
		backdrop-filter: blur(6px);
		border-bottom: 1px solid #1f1f1f;
	}

	.site-nav {
		max-width: 1120px;
		margin: 0 auto;
		padding: 0.7rem 1rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.brand-wrap {
		flex: 0 0 auto;
	}

	.brand {
		color: #f5f5f5;
		text-decoration: none;
		font-family: 'Space Grotesk', 'IBM Plex Mono', sans-serif;
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: 0.02em;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		flex-wrap: wrap;
	}

	.site-link {
		padding: 0.38rem 0.62rem;
		border-radius: 8px;
		border: 1px solid transparent;
		color: #d1d5db;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.82rem;
	}

	.site-link:hover {
		color: #ffffff;
		border-color: #2d2d2d;
		background: #0a0a0a;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border: 1px solid #2f2f2f;
		border-radius: 8px;
		background: #090909;
		color: #9ca3af;
		text-decoration: none;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		transition: all 0.2s ease;
	}

	.social-link:hover {
		border-color: #22d3ee;
		color: #22d3ee;
	}

	@media (max-width: 860px) {
		.site-nav {
			flex-wrap: wrap;
			justify-content: center;
		}

		.brand-wrap {
			width: 100%;
			display: flex;
			justify-content: center;
		}

		.social-links {
			width: 100%;
			justify-content: center;
		}
	}

	@media (max-width: 560px) {
		.site-link {
			font-size: 0.75rem;
			padding: 0.34rem 0.55rem;
		}
	}
</style>
