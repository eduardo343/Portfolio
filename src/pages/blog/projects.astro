---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Portfolio - Alan Ugarte" description="Retro gaming portfolio showcasing full stack development projects" />
		<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
		<style>
			/* Variables de colores neón */
			:root {
				--neon-green: #00ff41;
				--neon-cyan: #00ffff;
				--neon-magenta: #ff0080;
				--neon-yellow: #ffff00;
				--dark-bg: #0a0a0a;
				--console-bg: #1a1a1a;
				--screen-bg: #000814;
				--border-thick: 8px;
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				font-family: 'Press Start 2P', monospace;
				background: var(--dark-bg);
				color: var(--neon-green);
				overflow: hidden;
				height: 100vh;
				position: relative;
			}

			/* Grid animado de fondo */
			.retro-grid {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: linear-gradient(transparent 90%, var(--neon-cyan) 90%),
							linear-gradient(90deg, transparent 90%, var(--neon-cyan) 90%);
				background-size: 50px 50px;
				animation: grid-move 20s linear infinite;
				opacity: 0.1;
				z-index: 1;
				transform: perspective(800px) rotateX(60deg) translateZ(-200px);
			}

			@keyframes grid-move {
				0% { transform: perspective(800px) rotateX(60deg) translateZ(-200px) translateY(0); }
				100% { transform: perspective(800px) rotateX(60deg) translateZ(-200px) translateY(50px); }
			}

			/* Estrellas parpadeantes */
			.stars-container {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				z-index: 2;
			}

			.stars-container::before,
			.stars-container::after {
				content: '';
				position: absolute;
				width: 2px;
				height: 2px;
				background: var(--neon-yellow);
				border-radius: 50%;
				animation: twinkle 2s infinite alternate;
			}

			.stars-container::before {
				top: 20%;
				left: 10%;
				animation-delay: 0s;
			}

			.stars-container::after {
				top: 60%;
				right: 15%;
				animation-delay: 1s;
			}

			@keyframes twinkle {
				0% { opacity: 0.3; transform: scale(0.8); }
				100% { opacity: 1; transform: scale(1.2); }
			}

			/* Efectos scanline */
			.scanlines {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: repeating-linear-gradient(
					0deg,
					transparent,
					transparent 2px,
					rgba(0, 255, 65, 0.03) 2px,
					rgba(0, 255, 65, 0.03) 4px
				);
				pointer-events: none;
				z-index: 10;
			}

			/* Consola principal */
			.console {
				position: relative;
				width: 95%;
				max-width: 1200px;
				height: 90vh;
				margin: 5vh auto;
				background: var(--console-bg);
				border: var(--border-thick) solid var(--neon-cyan);
				border-radius: 20px;
				box-shadow: 
					0 0 20px var(--neon-cyan),
					inset 0 0 20px rgba(0, 255, 255, 0.1);
				z-index: 5;
				display: flex;
				flex-direction: column;
			}

			/* LEDs de estado */
			.console-leds {
				display: flex;
				gap: 15px;
				padding: 20px;
				justify-content: center;
			}

			.led {
				width: 12px;
				height: 12px;
				border-radius: 50%;
				border: 2px solid #333;
			}

			.led-power {
				background: var(--neon-green);
				box-shadow: 0 0 10px var(--neon-green);
				animation: pulse 2s infinite;
			}

			.led-data {
				background: var(--neon-yellow);
				box-shadow: 0 0 10px var(--neon-yellow);
				animation: pulse 1.5s infinite;
			}

			.led-system {
				background: var(--neon-magenta);
				box-shadow: 0 0 10px var(--neon-magenta);
				animation: pulse 3s infinite;
			}

			@keyframes pulse {
				0%, 100% { opacity: 1; }
				50% { opacity: 0.3; }
			}

			/* Pantalla principal */
			.screen {
				flex: 1;
				margin: 0 30px;
				background: var(--screen-bg);
				border: 6px solid #333;
				border-radius: 15px;
				position: relative;
				overflow: hidden;
				box-shadow: inset 0 0 50px rgba(0, 0, 0, 0.8);
			}

			.screen-content {
				padding: 40px;
				height: 100%;
				position: relative;
				z-index: 3;
			}

			/* Título con efecto glitch */
			.title-section {
				text-align: center;
				margin-bottom: 40px;
			}

			.glitch-title {
				font-size: 2.5rem;
				color: var(--neon-green);
				text-shadow: 
					2px 2px 0px var(--neon-magenta),
					-2px -2px 0px var(--neon-cyan);
				animation: glitch 3s infinite;
				position: relative;
			}

			@keyframes glitch {
				0%, 95% { transform: translate(0); }
				96% { transform: translate(2px, 1px); }
				97% { transform: translate(-1px, -1px); }
				98% { transform: translate(1px, 2px); }
				99% { transform: translate(-2px, -1px); }
				100% { transform: translate(0); }
			}

			.subtitle {
				font-size: 1rem;
				color: var(--neon-yellow);
				margin-top: 20px;
				animation: float 2s ease-in-out infinite alternate;
			}

			@keyframes float {
				from { transform: translateY(0px); }
				to { transform: translateY(-10px); }
			}

			/* Contenedor de proyectos */
			.projects-container {
				position: relative;
				height: 60%;
			}

			.project {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				opacity: 0;
				transform: translateX(100px);
				transition: all 0.3s ease;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 40px;
			}

			.project.active {
				opacity: 1;
				transform: translateX(0);
			}

			.project-header {
				text-align: center;
				animation: float 3s ease-in-out infinite alternate;
			}

			.level-indicator {
				font-size: 1.5rem;
				color: var(--neon-cyan);
				display: block;
				margin-bottom: 20px;
				text-shadow: 0 0 10px var(--neon-cyan);
			}

			.project-sprite {
				font-size: 6rem;
				filter: drop-shadow(0 0 20px var(--neon-yellow));
				animation: bounce 2s ease-in-out infinite;
			}

			@keyframes bounce {
				0%, 100% { transform: translateY(0px); }
				50% { transform: translateY(-20px); }
			}

			/* Cuadro de diálogo RPG */
			.dialog-box {
				background: linear-gradient(135deg, rgba(0, 20, 40, 0.9), rgba(0, 8, 20, 0.9));
				border: 4px solid var(--neon-green);
				border-radius: 15px;
				padding: 30px;
				max-width: 500px;
				box-shadow: 
					0 0 20px rgba(0, 255, 65, 0.3),
					inset 0 0 20px rgba(0, 255, 65, 0.1);
				position: relative;
			}

			.dialog-box::before {
				content: '';
				position: absolute;
				top: -10px;
				left: 30px;
				width: 0;
				height: 0;
				border-left: 10px solid transparent;
				border-right: 10px solid transparent;
				border-bottom: 10px solid var(--neon-green);
			}

			.dialog-header {
				border-bottom: 2px solid var(--neon-green);
				padding-bottom: 15px;
				margin-bottom: 20px;
			}

			.project-title {
				font-size: 1.2rem;
				color: var(--neon-green);
				text-shadow: 0 0 10px var(--neon-green);
			}

			.dialog-content p {
				font-size: 0.8rem;
				line-height: 1.6;
				color: #ccc;
				margin-bottom: 20px;
			}

			/* Badges de tecnologías */
			.tech-badges {
				display: flex;
				gap: 10px;
				flex-wrap: wrap;
			}

			.badge {
				padding: 8px 12px;
				font-size: 0.7rem;
				border-radius: 8px;
				border: 2px solid;
				background: rgba(0, 0, 0, 0.8);
				text-shadow: 0 0 5px currentColor;
				box-shadow: 0 0 10px currentColor;
				animation: glow 2s ease-in-out infinite alternate;
			}

			.badge.js { color: var(--neon-yellow); border-color: var(--neon-yellow); }
			.badge.canvas { color: var(--neon-magenta); border-color: var(--neon-magenta); }
			.badge.webgl { color: var(--neon-cyan); border-color: var(--neon-cyan); }
			.badge.react { color: var(--neon-cyan); border-color: var(--neon-cyan); }
			.badge.node { color: var(--neon-green); border-color: var(--neon-green); }
			.badge.mongo { color: var(--neon-green); border-color: var(--neon-green); }
			.badge.flutter { color: var(--neon-cyan); border-color: var(--neon-cyan); }
			.badge.firebase { color: var(--neon-magenta); border-color: var(--neon-magenta); }
			.badge.api { color: var(--neon-cyan); border-color: var(--neon-cyan); }
			.badge.python { color: var(--neon-green); border-color: var(--neon-green); }
			.badge.ai { color: var(--neon-magenta); border-color: var(--neon-magenta); }
			.badge.docker { color: var(--neon-cyan); border-color: var(--neon-cyan); }
			.badge.vue { color: var(--neon-green); border-color: var(--neon-green); }
			.badge.postgres { color: var(--neon-cyan); border-color: var(--neon-cyan); }
			.badge.solidity { color: var(--neon-yellow); border-color: var(--neon-yellow); }
			.badge.web3 { color: var(--neon-magenta); border-color: var(--neon-magenta); }
			.badge.next { color: var(--neon-cyan); border-color: var(--neon-cyan); }

			@keyframes glow {
				from { box-shadow: 0 0 5px currentColor; }
				to { box-shadow: 0 0 20px currentColor, 0 0 30px currentColor; }
			}

			/* Controles */
			.controls {
				padding: 30px;
				display: flex;
				justify-content: space-between;
				align-items: center;
				background: rgba(0, 0, 0, 0.3);
				border-top: 2px solid #333;
			}

			/* Barra de progreso */
			.progress-bar {
				display: flex;
				align-items: center;
				gap: 15px;
			}

			.progress-label {
				font-size: 0.8rem;
				color: var(--neon-cyan);
			}

			.progress-container {
				width: 200px;
				height: 20px;
				background: #333;
				border: 2px solid var(--neon-cyan);
				border-radius: 10px;
				overflow: hidden;
				position: relative;
			}

			.progress-fill {
				height: 100%;
				width: 25%;
				background: linear-gradient(90deg, var(--neon-green), var(--neon-cyan));
				border-radius: 8px;
				transition: width 0.3s ease;
				box-shadow: 0 0 10px var(--neon-green);
			}

			/* Display digital */
			.digital-display {
				font-size: 1.5rem;
				color: var(--neon-green);
				background: #000;
				padding: 15px 25px;
				border: 3px solid var(--neon-green);
				border-radius: 10px;
				text-shadow: 0 0 10px var(--neon-green);
				box-shadow: 
					0 0 20px rgba(0, 255, 65, 0.3),
					inset 0 0 10px rgba(0, 255, 65, 0.1);
			}

			.separator {
				animation: blink 1s infinite;
			}

			@keyframes blink {
				0%, 50% { opacity: 1; }
				51%, 100% { opacity: 0.3; }
			}

			/* Botones de navegación */
			.nav-buttons {
				display: flex;
				gap: 20px;
			}

			.nav-btn {
				width: 80px;
				height: 80px;
				background: linear-gradient(145deg, #2a2a2a, #1a1a1a);
				border: 4px solid var(--neon-magenta);
				border-radius: 50%;
				color: var(--neon-magenta);
				font-size: 2rem;
				cursor: pointer;
				transition: all 0.2s ease;
				box-shadow: 
					0 8px 16px rgba(0, 0, 0, 0.3),
					0 0 20px rgba(255, 0, 128, 0.3),
					inset 0 0 10px rgba(255, 0, 128, 0.1);
				position: relative;
			}

			.nav-btn:hover {
				transform: translateY(-3px) scale(1.05);
				box-shadow: 
					0 12px 24px rgba(0, 0, 0, 0.4),
					0 0 30px rgba(255, 0, 128, 0.6),
					inset 0 0 15px rgba(255, 0, 128, 0.2);
			}

			.nav-btn:active {
				transform: translateY(2px) scale(0.95);
			}

			.nav-btn:disabled {
				opacity: 0.3;
				cursor: not-allowed;
				transform: none;
			}

			.btn-icon {
				text-shadow: 0 0 10px currentColor;
			}

			/* Responsivo */
			@media (max-width: 768px) {
				.console {
					width: 98%;
					height: 95vh;
					margin: 2.5vh auto;
				}
				
				.glitch-title {
					font-size: 1.8rem;
				}
				
				.project {
					flex-direction: column;
					gap: 20px;
				}
				
				.project-sprite {
					font-size: 4rem;
				}
				
				.controls {
					flex-direction: column;
					gap: 20px;
					padding: 20px;
				}
				
				.nav-btn {
					width: 60px;
					height: 60px;
					font-size: 1.5rem;
				}
				
				.progress-container {
					width: 150px;
				}
			}
		</style>
	</head>
	<body>
		<!-- Grid animado de fondo -->
		<div class="retro-grid"></div>
		<div class="stars-container"></div>
		<div class="scanlines"></div>
		
		<div class="flex flex-col min-h-screen">
			<Header />
			
			<main class="flex-1">
				<!-- Consola principal -->
				<div class="console">
					<!-- LEDs de estado -->
					<div class="console-leds">
						<div class="led led-power"></div>
						<div class="led led-data"></div>
						<div class="led led-system"></div>
					</div>
					
					<!-- Pantalla principal -->
					<div class="screen">
						<div class="screen-content">
							<!-- Título con efecto glitch -->
							<div class="title-section">
								<h1 class="glitch-title" data-text="ALAN'S PORTFOLIO">ALAN'S PORTFOLIO</h1>
								<p class="subtitle">>>> LEVEL SELECT <<<</p>
							</div>
							
							<!-- Contenedor de proyectos -->
							<div class="projects-container">
								<!-- Proyecto 1 -->
								<div class="project active" data-level="1">
									<div class="project-header">
										<span class="level-indicator">LVL 01</span>
										<div class="project-sprite">🚀</div>
									</div>
									<div class="dialog-box">
										<div class="dialog-header">
											<span class="project-title">SPACE INVADERS CLONE</span>
										</div>
										<div class="dialog-content">
											<p>Recreación del clásico arcade con mecánicas modernas, power-ups y efectos de partículas. Incluye tabla de puntuaciones y múltiples niveles.</p>
											<div class="tech-badges">
												<span class="badge js">JS</span>
												<span class="badge canvas">CANVAS</span>
												<span class="badge webgl">WEBGL</span>
											</div>
										</div>
									</div>
								</div>
								
								<!-- Proyecto 2 -->
								<div class="project" data-level="2">
									<div class="project-header">
										<span class="level-indicator">LVL 02</span>
										<div class="project-sprite">🛒</div>
									</div>
									<div class="dialog-box">
										<div class="dialog-header">
											<span class="project-title">E-COMMERCE DASHBOARD</span>
										</div>
										<div class="dialog-content">
											<p>Panel de administración completo con analytics en tiempo real, gestión de inventario y procesamiento de pagos seguros.</p>
											<div class="tech-badges">
												<span class="badge react">REACT</span>
												<span class="badge node">NODE</span>
												<span class="badge mongo">MONGO</span>
											</div>
										</div>
									</div>
								</div>
								
								<!-- Proyecto 3 -->
								<div class="project" data-level="3">
									<div class="project-header">
										<span class="level-indicator">LVL 03</span>
										<div class="project-sprite">🏃‍♂️</div>
									</div>
									<div class="dialog-box">
										<div class="dialog-header">
											<span class="project-title">FITNESS TRACKER APP</span>
										</div>
										<div class="dialog-content">
											<p>App móvil con seguimiento GPS, métricas de salud, retos sociales y integración con dispositivos wearables.</p>
											<div class="tech-badges">
												<span class="badge flutter">FLUTTER</span>
												<span class="badge firebase">FIRE</span>
												<span class="badge api">REST</span>
											</div>
										</div>
									</div>
								</div>
								
								<!-- Proyecto 4 -->
								<div class="project" data-level="4">
									<div class="project-header">
										<span class="level-indicator">LVL 04</span>
										<div class="project-sprite">🧠</div>
									</div>
									<div class="dialog-box">
										<div class="dialog-header">
											<span class="project-title">AI IMAGE GENERATOR</span>
										</div>
										<div class="dialog-content">
											<p>Generador de imágenes con IA usando modelos de difusión. Interface web intuitiva con historial y personalización avanzada.</p>
											<div class="tech-badges">
												<span class="badge python">PYTHON</span>
												<span class="badge ai">AI/ML</span>
												<span class="badge docker">DOCKER</span>
											</div>
										</div>
									</div>
								</div>
								
								<!-- Proyecto 5 -->
								<div class="project" data-level="5">
									<div class="project-header">
										<span class="level-indicator">LVL 05</span>
										<div class="project-sprite">🎵</div>
									</div>
									<div class="dialog-box">
										<div class="dialog-header">
											<span class="project-title">MUSIC STREAMING PLATFORM</span>
										</div>
										<div class="dialog-content">
											<p>Plataforma de streaming con recomendaciones IA, playlists colaborativas y reproductor con visualizador de ondas.</p>
											<div class="tech-badges">
												<span class="badge vue">VUE</span>
												<span class="badge node">NODE</span>
												<span class="badge postgres">PSQL</span>
											</div>
										</div>
									</div>
								</div>
								
								<!-- Proyecto 6 -->
								<div class="project" data-level="6">
									<div class="project-header">
										<span class="level-indicator">LVL 06</span>
										<div class="project-sprite">⚡</div>
									</div>
									<div class="dialog-box">
										<div class="dialog-header">
											<span class="project-title">BLOCKCHAIN WALLET</span>
										</div>
										<div class="dialog-content">
											<p>Cartera de criptomonedas multi-chain con intercambio DEX, staking y portfolio tracking. Seguridad de grado bancario.</p>
											<div class="tech-badges">
												<span class="badge solidity">SOL</span>
												<span class="badge web3">WEB3</span>
												<span class="badge next">NEXT</span>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					
					<!-- Controles -->
					<div class="controls">
						<!-- Barra de progreso -->
						<div class="progress-bar">
							<div class="progress-label">PROGRESS</div>
							<div class="progress-container">
								<div class="progress-fill"></div>
							</div>
						</div>
						
						<!-- Display digital -->
						<div class="digital-display">
							<span class="current-page">01</span>
							<span class="separator">/</span>
							<span class="total-pages">06</span>
						</div>
						
						<!-- Botones de navegación -->
						<div class="nav-buttons">
							<button class="nav-btn prev-btn" id="prevBtn">
								<span class="btn-icon">◄</span>
							</button>
							<button class="nav-btn next-btn" id="nextBtn">
								<span class="btn-icon">►</span>
							</button>
						</div>
					</div>
				</div>
			</main>
			
			<Footer />
		</div>
		
		<script>
			class RetroPortfolio {
				constructor() {
					this.currentProject = 0;
					this.totalProjects = 6;
					this.projects = document.querySelectorAll('.project');
					this.prevBtn = document.getElementById('prevBtn');
					this.nextBtn = document.getElementById('nextBtn');
					this.progressFill = document.querySelector('.progress-fill');
					this.currentPageDisplay = document.querySelector('.current-page');
					
					this.init();
					this.createStars();
					this.bindEvents();
					this.updateDisplay();
				}
				
				init() {
					this.showProject(0);
					this.updateButtons();
				}
				
				createStars() {
					const starsContainer = document.querySelector('.stars-container');
					
					for (let i = 0; i < 15; i++) {
						const star = document.createElement('div');
						star.className = 'star';
						star.style.cssText = `
							position: absolute;
							width: ${Math.random() * 3 + 1}px;
							height: ${Math.random() * 3 + 1}px;
							background: var(--neon-yellow);
							border-radius: 50%;
							top: ${Math.random() * 100}%;
							left: ${Math.random() * 100}%;
							animation: twinkle ${Math.random() * 3 + 1}s infinite alternate;
							animation-delay: ${Math.random() * 2}s;
							box-shadow: 0 0 6px var(--neon-yellow);
						`;
						starsContainer.appendChild(star);
					}
				}
				
				bindEvents() {
					this.prevBtn.addEventListener('click', () => this.navigateProject(-1));
					this.nextBtn.addEventListener('click', () => this.navigateProject(1));
					
					document.addEventListener('keydown', (e) => {
						switch(e.key) {
							case 'ArrowLeft':
							case 'a':
							case 'A':
								e.preventDefault();
								this.navigateProject(-1);
								break;
							case 'ArrowRight':
							case 'd':
							case 'D':
								e.preventDefault();
								this.navigateProject(1);
								break;
						}
					});
					
					[this.prevBtn, this.nextBtn].forEach(btn => {
						btn.addEventListener('click', () => this.playClickEffect(btn));
					});
					
					this.setupTouchEvents();
				}
				
				setupTouchEvents() {
					let touchStartX = 0;
					let touchEndX = 0;
					
					const screen = document.querySelector('.screen');
					
					screen.addEventListener('touchstart', (e) => {
						touchStartX = e.changedTouches[0].screenX;
					});
					
					screen.addEventListener('touchend', (e) => {
						touchEndX = e.changedTouches[0].screenX;
						this.handleSwipe();
					});
					
					const handleSwipe = () => {
						const swipeThreshold = 50;
						const diff = touchStartX - touchEndX;
						
						if (Math.abs(diff) > swipeThreshold) {
							if (diff > 0) {
								this.navigateProject(1);
							} else {
								this.navigateProject(-1);
							}
						}
					};
					
					this.handleSwipe = handleSwipe;
				}
				
				navigateProject(direction) {
					const newIndex = this.currentProject + direction;
					
					if (newIndex >= 0 && newIndex < this.totalProjects) {
						this.showProject(newIndex);
						this.vibrateDevice();
					}
				}
				
				showProject(index) {
					if (this.projects[this.currentProject]) {
						this.projects[this.currentProject].classList.remove('active');
					}
					
					this.currentProject = index;
					
					setTimeout(() => {
						this.projects[this.currentProject].classList.add('active');
					}, 150);
					
					this.updateDisplay();
					this.updateButtons();
					this.triggerScreenEffect();
				}
				
				updateDisplay() {
					this.currentPageDisplay.textContent = (this.currentProject + 1).toString().padStart(2, '0');
					
					const progressPercentage = ((this.currentProject + 1) / this.totalProjects) * 100;
					this.progressFill.style.width = `${progressPercentage}%`;
				}
				
				updateButtons() {
					this.prevBtn.disabled = this.currentProject === 0;
					this.nextBtn.disabled = this.currentProject === this.totalProjects - 1;
				}
				
				triggerScreenEffect() {
					const screen = document.querySelector('.screen');
					screen.style.filter = 'brightness(1.5) contrast(1.2)';
					
					setTimeout(() => {
						screen.style.filter = 'brightness(1) contrast(1)';
					}, 100);
				}
				
				playClickEffect(button) {
					button.style.transform = 'translateY(2px) scale(0.95)';
					
					setTimeout(() => {
						button.style.transform = '';
					}, 150);
					
					this.vibrateDevice();
				}
				
				vibrateDevice() {
					if (navigator.vibrate) {
						navigator.vibrate(50);
					}
				}
			}
			
			document.addEventListener('DOMContentLoaded', () => {
				const portfolio = new RetroPortfolio();
				
				setInterval(() => {
					if (Math.random() < 0.3) {
						const title = document.querySelector('.glitch-title');
						title.style.filter = 'hue-rotate(180deg)';
						setTimeout(() => {
							title.style.filter = '';
						}, 500);
					}
				}, 10000);
				
				window.portfolio = portfolio;
			});
			
			document.addEventListener('touchstart', function(event) {
				if (event.touches.length > 1) {
					event.preventDefault();
				}
			});
			
			let lastTouchEnd = 0;
			document.addEventListener('touchend', function(event) {
				const now = (new Date()).getTime();
				if (now - lastTouchEnd <= 300) {
					event.preventDefault();
				}
				lastTouchEnd = now;
			}, false);
		</script>
	</body>
</html>