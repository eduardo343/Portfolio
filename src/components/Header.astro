---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, GITHUB_URL, LINKEDIN_URL } from '../consts';
import { getLang, withLang } from '../utils/i18n';

const lang = getLang(Astro.url);

const copy = {
	es: {
		home: 'Inicio',
		projects: 'Proyectos',
		about: 'Acerca',
		contact: 'Contacto',
		tagline: 'Portafolio de desarrollo',
		social: 'Redes'
	},
	en: {
		home: 'Home',
		projects: 'Projects',
		about: 'About',
		contact: 'Contact',
		tagline: 'Development portfolio',
		social: 'Networks'
	}
} as const;

const t = copy[lang];

const navigation = [
	{ href: '/', label: t.home },
	{ href: '/blog', label: t.projects },
	{ href: '/about', label: t.about },
	{ href: '/contact', label: t.contact }
];

const esHref = withLang(Astro.url.pathname, 'es');
const enHref = withLang(Astro.url.pathname, 'en');
---

<header class="aztec-header">
	<nav class="aztec-nav">
		<a class="brand" href={withLang('/', lang)}>
			<span class="brand-mark" aria-hidden="true">☀</span>
			<span class="brand-text">
				<strong>{SITE_TITLE}</strong>
				<small>{t.tagline}</small>
			</span>
		</a>

		<div class="internal-links">
			{navigation.map((item) => (
				<HeaderLink href={withLang(item.href, lang)} class="aztec-link">
					{item.label}
				</HeaderLink>
			))}
		</div>

		<div class="utility-nav">
			<div class="lang-switch" role="tablist" aria-label="Language">
				<a href={esHref} class:list={["lang-pill", { active: lang === 'es' }]}>ES</a>
				<a href={enHref} class:list={["lang-pill", { active: lang === 'en' }]}>EN</a>
			</div>

			<div class="social-links" aria-label={t.social}>
				<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="social-link">
					LinkedIn
				</a>
				<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="social-link">
					GitHub
				</a>
			</div>
		</div>
	</nav>
</header>

<style>
	.aztec-header {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 2px solid rgba(142, 63, 42, 0.45);
		background:
			repeating-linear-gradient(90deg, rgba(179, 90, 63, 0.1) 0 24px, rgba(0, 0, 0, 0) 24px 48px),
			linear-gradient(180deg, rgba(250, 240, 216, 0.96), rgba(236, 217, 182, 0.92));
		backdrop-filter: blur(4px);
	}

	.aztec-header::after {
		content: '';
		display: block;
		height: 7px;
		background:
			repeating-linear-gradient(-45deg, rgba(47, 123, 106, 0.7) 0 8px, transparent 8px 16px),
			repeating-linear-gradient(45deg, rgba(195, 146, 58, 0.75) 0 8px, transparent 8px 16px);
		opacity: 0.8;
	}

	.aztec-nav {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.85rem 1.2rem;
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 1rem;
		align-items: center;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: #2e1f17;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		background: linear-gradient(145deg, #e0b55f, #c78638);
		box-shadow: inset 0 0 0 1px rgba(46, 31, 23, 0.2);
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.1;
	}

	.brand-text strong {
		font-family: 'Cinzel', 'Palatino Linotype', serif;
		font-size: 0.95rem;
		letter-spacing: 0.03em;
	}

	.brand-text small {
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgba(46, 31, 23, 0.74);
	}

	.internal-links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.aztec-link {
		padding: 0.4rem 0.7rem;
		border: 1px solid rgba(46, 31, 23, 0.22);
		background: rgba(255, 249, 236, 0.65);
		font-size: 0.82rem;
		font-weight: 700;
		color: rgba(46, 31, 23, 0.86);
	}

	.aztec-link:hover {
		border-color: rgba(142, 63, 42, 0.5);
		transform: translateY(-1px);
	}

	.utility-nav {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.lang-switch {
		display: inline-flex;
		padding: 0.2rem;
		border: 1px solid rgba(46, 31, 23, 0.25);
		background: rgba(255, 255, 255, 0.5);
	}

	.lang-pill {
		padding: 0.3rem 0.55rem;
		font-size: 0.75rem;
		font-weight: 800;
		color: #2e1f17;
		text-decoration: none;
	}

	.lang-pill.active {
		background: #2f7b6a;
		color: #fdf5e7;
	}

	.social-links {
		display: flex;
		gap: 0.5rem;
	}

	.social-link {
		padding: 0.3rem 0.55rem;
		font-size: 0.75rem;
		font-weight: 700;
		text-decoration: none;
		border: 1px solid rgba(46, 31, 23, 0.24);
		color: rgba(46, 31, 23, 0.85);
		background: rgba(255, 255, 255, 0.42);
	}

	.social-link:hover {
		border-color: rgba(47, 123, 106, 0.7);
		background: rgba(47, 123, 106, 0.1);
	}

	@media (max-width: 980px) {
		.aztec-nav {
			grid-template-columns: 1fr;
			justify-items: center;
		}

		.internal-links {
			order: 2;
		}

		.utility-nav {
			order: 3;
			flex-wrap: wrap;
			justify-content: center;
		}
	}

	@media (max-width: 640px) {
		.brand-text small {
			display: none;
		}

		.aztec-link {
			font-size: 0.75rem;
		}
	}
</style>
