---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <BaseHead title="Contact" description="Formulario de contacto" />
  </head>
  <body class="bg-gray-100 text-gray-900">
    <Header />
    <main class="max-w-4xl mx-auto p-4">
      <section class="bg-white shadow-lg rounded-lg p-6 mt-6">
        <h1 class="text-3xl font-bold mb-4 text-center text-blue-600">Contact Me</h1>
        <form
          class="space-y-4"
          method="POST"
          action="https://formspree.io/f/mldbgzvv"
        >
          <div>
            <label class="block mb-1 font-medium" for="name">
              Name:
            </label>
            <input
              class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
              type="text"
              id="name"
              name="name"
              required
            />
          </div>
          <div>
            <label class="block mb-1 font-medium" for="email">
              Email:
            </label>
            <input
              class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
              type="email"
              id="email"
              name="email"
              required
            />
          </div>
          <div>
            <label class="block mb-1 font-medium" for="message">
              Message:
            </label>
            <textarea
              class="w-full border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
              id="message"
              name="message"
              rows="5"
              required
            ></textarea>
          </div>
          <button
            class="w-full bg-blue-600 text-white py-2 rounded-md hover:bg-blue-700 transition duration-300"
            type="submit"
          >
            Enviar
          </button>
        </form>

        <div class="mt-6 text-center">
          <p class="mb-2">¿Would you like to schedule a call?</p>
          <a
            href="https://calendly.com/alansaucedo-dev/30min"
            target="_blank"
            rel="noopener"
            class="inline-block bg-white text-black py-2 px-4 rounded-md hover:bg-blue-700 transition duration-300"
          >
            Schedule on Calendly
          </a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
