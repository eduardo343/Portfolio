		<script>
			class RetroPortfolio {
				currentProject = 0;
				totalProjects: number;
				projects: HTMLElement[];
				prevBtn: HTMLButtonElement;
				nextBtn: HTMLButtonElement;
				progressFill: HTMLElement;
				currentPageDisplay: HTMLElement;
				screen: HTMLElement;
				touchStartX = 0;
				touchEndX = 0;

				constructor() {
					this.projects = Array.from(document.querySelectorAll<HTMLElement>('.project'));

					const prevBtn = document.querySelector<HTMLButtonElement>('#prevBtn');
					const nextBtn = document.querySelector<HTMLButtonElement>('#nextBtn');
					const progressFill = document.querySelector<HTMLElement>('.progress-fill');
					const currentPageDisplay = document.querySelector<HTMLElement>('.current-page');
					const screen = document.querySelector<HTMLElement>('.screen');

					if (
						!prevBtn ||
						!nextBtn ||
						!progressFill ||
						!currentPageDisplay ||
						!screen ||
						this.projects.length === 0
					) {
						throw new Error('RetroPortfolio: Missing required DOM elements.');
					}

					this.totalProjects = this.projects.length;
					this.prevBtn = prevBtn;
					this.nextBtn = nextBtn;
					this.progressFill = progressFill;
					this.currentPageDisplay = currentPageDisplay;
					this.screen = screen;

					this.init();
					this.createStars();
					this.bindEvents();
					this.updateDisplay();
				}

				init() {
					this.showProject(0);
					this.updateButtons();
				}

				createStars() {
					const starsContainer = document.querySelector<HTMLElement>('.stars-container');
					if (!starsContainer) {
						return;
					}

					for (let i = 0; i < 15; i++) {
						const star = document.createElement('div');
						star.className = 'star';
						star.style.cssText = `
							position: absolute;
							width: ${Math.random() * 3 + 1}px;
							height: ${Math.random() * 3 + 1}px;
							background: var(--neon-yellow);
							border-radius: 50%;
							top: ${Math.random() * 100}%;
							left: ${Math.random() * 100}%;
							animation: twinkle ${Math.random() * 3 + 1}s infinite alternate;
							animation-delay: ${Math.random() * 2}s;
							box-shadow: 0 0 6px var(--neon-yellow);
						`;
						starsContainer.appendChild(star);
					}
				}

				bindEvents() {
					this.prevBtn.addEventListener('click', () => this.navigateProject(-1));
					this.nextBtn.addEventListener('click', () => this.navigateProject(1));

					document.addEventListener('keydown', (e: KeyboardEvent) => {
						switch (e.key) {
							case 'ArrowLeft':
							case 'a':
							case 'A':
								e.preventDefault();
								this.navigateProject(-1);
								break;
							case 'ArrowRight':
							case 'd':
							case 'D':
								e.preventDefault();
								this.navigateProject(1);
								break;
						}
					});

					[this.prevBtn, this.nextBtn].forEach((btn) => {
						btn.addEventListener('click', () => this.playClickEffect(btn));
					});

					this.setupTouchEvents();
				}

				setupTouchEvents() {
					this.screen.addEventListener('touchstart', (e: TouchEvent) => {
						this.touchStartX = e.changedTouches[0]?.screenX ?? 0;
					});

					this.screen.addEventListener('touchend', (e: TouchEvent) => {
						this.touchEndX = e.changedTouches[0]?.screenX ?? 0;
						this.handleSwipe();
					});
				}

				handleSwipe() {
					const swipeThreshold = 50;
					const diff = this.touchStartX - this.touchEndX;

					if (Math.abs(diff) <= swipeThreshold) {
						return;
					}

					if (diff > 0) {
						this.navigateProject(1);
					} else {
						this.navigateProject(-1);
					}
				}

				navigateProject(direction: number) {
					const newIndex = this.currentProject + direction;

					if (newIndex >= 0 && newIndex < this.totalProjects) {
						this.showProject(newIndex);
						this.vibrateDevice();
					}
				}

				showProject(index: number) {
					const activeProject = this.projects[this.currentProject];
					if (activeProject) {
						activeProject.classList.remove('active');
					}

					this.currentProject = index;

					setTimeout(() => {
						const nextProject = this.projects[this.currentProject];
						if (nextProject) {
							nextProject.classList.add('active');
						}
					}, 150);

					this.updateDisplay();
					this.updateButtons();
					this.triggerScreenEffect();
				}

				updateDisplay() {
					this.currentPageDisplay.textContent = (this.currentProject + 1).toString().padStart(2, '0');

					const progressPercentage = ((this.currentProject + 1) / this.totalProjects) * 100;
					this.progressFill.style.width = `${progressPercentage}%`;
				}

				updateButtons() {
					this.prevBtn.disabled = this.currentProject === 0;
					this.nextBtn.disabled = this.currentProject === this.totalProjects - 1;
				}

				triggerScreenEffect() {
					this.screen.style.filter = 'brightness(1.5) contrast(1.2)';

					setTimeout(() => {
						this.screen.style.filter = 'brightness(1) contrast(1)';
					}, 100);
				}

				playClickEffect(button: HTMLButtonElement) {
					button.style.transform = 'translateY(2px) scale(0.95)';

					setTimeout(() => {
						button.style.transform = '';
					}, 150);

					this.vibrateDevice();
				}

				vibrateDevice() {
					if ('vibrate' in navigator) {
						navigator.vibrate(50);
					}
				}
			}

			document.addEventListener('DOMContentLoaded', () => {
				let portfolio: RetroPortfolio;
				try {
					portfolio = new RetroPortfolio();
				} catch (error) {
					console.error(error);
					return;
				}

				setInterval(() => {
					if (Math.random() < 0.3) {
						const title = document.querySelector<HTMLElement>('.glitch-title');
						if (!title) {
							return;
						}

						title.style.filter = 'hue-rotate(180deg)';
						setTimeout(() => {
							title.style.filter = '';
						}, 500);
					}
				}, 10000);

				(window as Window & { portfolio?: RetroPortfolio }).portfolio = portfolio;
			});

			document.addEventListener('touchstart', (event: TouchEvent) => {
				if (event.touches.length > 1) {
					event.preventDefault();
				}
			});

			let lastTouchEnd = 0;
			document.addEventListener(
				'touchend',
				(event: TouchEvent) => {
					const now = new Date().getTime();
					if (now - lastTouchEnd <= 300) {
						event.preventDefault();
					}
					lastTouchEnd = now;
				},
				false
			);
		</script>
	</body>
</html>
