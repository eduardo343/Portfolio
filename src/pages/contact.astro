---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLang } from '../utils/i18n';

const lang = getLang(Astro.url);

const copy = {
	es: {
		title: 'Contacto | Alan Ugarte',
		description: 'Formulario de contacto para colaboraciones, freelance y nuevas ideas de producto.',
		header: 'Hablemos de tu proyecto',
		subtitle: 'Comparte objetivo, alcance y tiempos estimados. Respondere por correo con una propuesta clara.',
		name: 'Nombre',
		email: 'Correo',
		message: 'Detalles del proyecto',
		namePlaceholder: 'Tu nombre',
		emailPlaceholder: 'tu.correo@dominio.com',
		messagePlaceholder: 'Que necesitas construir y para cuando?',
		submit: 'Enviar mensaje',
		calendlyText: 'Prefieres una llamada directa?',
		calendlyCta: 'Agendar llamada'
	},
	en: {
		title: 'Contact | Alan Ugarte',
		description: 'Contact form for collaborations, freelance work, and new product ideas.',
		header: 'Let us discuss your project',
		subtitle: 'Share goals, scope, and expected timeline. I will reply by email with a clear proposal.',
		name: 'Name',
		email: 'Email',
		message: 'Project details',
		namePlaceholder: 'Your name',
		emailPlaceholder: 'your.email@domain.com',
		messagePlaceholder: 'What do you need to build and by when?',
		submit: 'Send message',
		calendlyText: 'Prefer a direct call?',
		calendlyCta: 'Schedule call'
	}
} as const;

const t = copy[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={t.title} description={t.description} />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        font-family: 'Manrope', 'Segoe UI', sans-serif;
        background:
          radial-gradient(circle at 12% 0%, rgba(227, 174, 92, 0.22), transparent 38%),
          radial-gradient(circle at 90% 18%, rgba(47, 123, 106, 0.17), transparent 35%),
          linear-gradient(180deg, #fbf2de 0%, #f1dfbb 100%);
        color: #2e1f17;
      }

      main {
        max-width: 860px;
        margin: 0 auto;
        padding: 1.2rem 1rem 2.2rem;
      }

      .contact-card {
        border: 3px solid #8e3f2a;
        background:
          repeating-linear-gradient(45deg, rgba(179, 90, 63, 0.1) 0 14px, transparent 14px 28px),
          linear-gradient(155deg, rgba(248, 236, 210, 0.95), rgba(236, 214, 173, 0.9));
        box-shadow: 0 14px 28px rgba(89, 49, 36, 0.18);
        padding: clamp(1rem, 2.5vw, 1.7rem);
      }

      h1 {
        margin: 0;
        font-family: 'Cinzel', 'Georgia', serif;
        font-size: clamp(1.5rem, 3vw, 2.2rem);
        letter-spacing: 0.04em;
        color: #8e3f2a;
      }

      .lead {
        margin: 0.7rem 0 1rem;
        line-height: 1.5;
        color: rgba(46, 31, 23, 0.86);
      }

      .field {
        margin-bottom: 0.95rem;
      }

      label {
        display: block;
        margin-bottom: 0.35rem;
        font-size: 0.85rem;
        font-weight: 700;
        color: #2f7b6a;
      }

      input,
      textarea {
        width: 100%;
        padding: 0.65rem 0.7rem;
        border: 1px solid rgba(46, 31, 23, 0.28);
        background: rgba(255, 251, 242, 0.8);
        color: #2e1f17;
        font: inherit;
        font-size: 0.95rem;
      }

      input:focus,
      textarea:focus {
        outline: 2px solid rgba(47, 123, 106, 0.45);
        outline-offset: 1px;
      }

      .submit {
        width: 100%;
        border: 1px solid rgba(46, 31, 23, 0.34);
        background: linear-gradient(145deg, #2f7b6a, #255f53);
        color: #f8edd3;
        font-weight: 800;
        font-size: 0.95rem;
        padding: 0.7rem;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 16px rgba(46, 31, 23, 0.16);
      }

      .calendly {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px dashed rgba(142, 63, 42, 0.5);
        text-align: center;
      }

      .calendly p {
        margin: 0 0 0.6rem;
        color: rgba(46, 31, 23, 0.84);
      }

      .calendly a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem 0.9rem;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 700;
        border: 1px solid rgba(142, 63, 42, 0.5);
        background: rgba(255, 255, 255, 0.6);
        color: #8e3f2a;
      }

      .calendly a:hover {
        border-color: rgba(47, 123, 106, 0.7);
        background: rgba(47, 123, 106, 0.12);
      }
    </style>
  </head>
  <body>
    <div class="flex flex-col min-h-screen">
      <Header />

      <main class="flex-1">
        <section class="contact-card">
          <h1>{t.header}</h1>
          <p class="lead">{t.subtitle}</p>

          <form method="POST" action="https://formspree.io/f/mldbgzvv">
            <div class="field">
              <label for="name">{t.name}</label>
              <input id="name" name="name" type="text" placeholder={t.namePlaceholder} required />
            </div>

            <div class="field">
              <label for="email">{t.email}</label>
              <input id="email" name="email" type="email" placeholder={t.emailPlaceholder} required />
            </div>

            <div class="field">
              <label for="message">{t.message}</label>
              <textarea id="message" name="message" rows="6" placeholder={t.messagePlaceholder} required></textarea>
            </div>

            <button class="submit" type="submit">{t.submit}</button>
          </form>

          <div class="calendly">
            <p>{t.calendlyText}</p>
            <a href="https://calendly.com/alansaucedo-dev/30min" target="_blank" rel="noopener noreferrer">
              {t.calendlyCta}
            </a>
          </div>
        </section>
      </main>

      <Footer />
    </div>
  </body>
</html>
