					};

					const pageTitles = {
						es: 'Sobre Alan Ugarte - Full Stack Developer',
						en: 'About Alan Ugarte - Full Stack Developer'
					};

					const render = (lang) => {
						languageApi.applyTranslations(root, translations, lang);
						document.title = pageTitles[lang] || pageTitles.en;
					};

					render(languageApi.getLang());
					window.addEventListener('portfolio-lang-change', (event) => {
						render(event.detail);
					});
				})();
			</script>
		</body>
</html>
