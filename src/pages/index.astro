---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { getLang, withLang } from '../utils/i18n';

const lang = getLang(Astro.url);

const copy = {
	es: {
		title: 'Inicio | Alan Ugarte',
		description: 'Desarrollo web full stack con enfoque en productos escalables y experiencia de usuario.',
		kicker: 'Desarrollo Full Stack',
		headline: 'Construyo productos web claros, rapidos y mantenibles.',
		subtitle: 'Trabajo con Laravel, Angular y ecosistemas modernos para convertir ideas de negocio en software real.',
		primaryCta: 'Hablar de tu proyecto',
		secondaryCta: 'Ver proyectos',
		thirdCta: 'Mi experiencia',
		focusTitle: 'Enfoque actual',
		focusItems: [
			'Arquitectura backend con Laravel 11 y APIs robustas.',
			'Frontends interactivos con Angular 19 y TypeScript.',
			'Integracion de datos con MongoDB, Firebase y DynamoDB.'
		],
		badge: 'Disponible para freelance y colaboraciones.'
	},
	en: {
		title: 'Home | Alan Ugarte',
		description: 'Full-stack web development focused on scalable products and practical user experience.',
		kicker: 'Full-Stack Development',
		headline: 'I build web products that are clear, fast, and maintainable.',
		subtitle: 'I work with Laravel, Angular, and modern ecosystems to turn business ideas into production-ready software.',
		primaryCta: 'Discuss your project',
		secondaryCta: 'View projects',
		thirdCta: 'My background',
		focusTitle: 'Current Focus',
		focusItems: [
			'Backend architecture with Laravel 11 and robust APIs.',
			'Interactive frontends with Angular 19 and TypeScript.',
			'Data integrations with MongoDB, Firebase, and DynamoDB.'
		],
		badge: 'Available for freelance and collaborations.'
	}
} as const;

const t = copy[lang];
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={t.title} description={t.description} />
		<style>
			body {
				margin: 0;
				min-height: 100vh;
				font-family: 'Manrope', 'Segoe UI', sans-serif;
				background:
					radial-gradient(circle at 10% 0%, rgba(227, 174, 92, 0.24), transparent 42%),
					radial-gradient(circle at 90% 18%, rgba(47, 123, 106, 0.2), transparent 38%),
					linear-gradient(180deg, #fbf2de 0%, #f0dfbc 100%);
				color: #2e1f17;
			}

			main {
				max-width: 1140px;
				margin: 0 auto;
				padding: clamp(1.1rem, 2vw, 2rem) clamp(1rem, 3vw, 2rem) 2.5rem;
			}

			.hero {
				position: relative;
				padding: clamp(1.2rem, 3vw, 2.6rem);
				border: 3px solid #8e3f2a;
				background:
					repeating-linear-gradient(45deg, rgba(179, 90, 63, 0.1) 0 14px, transparent 14px 28px),
					linear-gradient(160deg, rgba(248, 236, 210, 0.95), rgba(237, 214, 173, 0.92));
				box-shadow: 0 16px 30px rgba(89, 49, 36, 0.2);
				overflow: hidden;
			}

			.hero::after {
				content: '';
				position: absolute;
				inset: 0;
				background: repeating-linear-gradient(-45deg, rgba(47, 123, 106, 0.08) 0 10px, transparent 10px 20px);
				pointer-events: none;
			}

			.hero-content {
				position: relative;
				z-index: 1;
			}

			.kicker {
				margin: 0;
				font-size: 0.78rem;
				font-weight: 800;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: #2f7b6a;
			}

			h1 {
				font-family: 'Cinzel', 'Palatino Linotype', serif;
				font-size: clamp(1.7rem, 4vw, 3rem);
				line-height: 1.1;
				margin: 0.6rem 0 0.8rem;
				color: #8e3f2a;
				max-width: 780px;
			}

			.subtitle {
				margin: 0;
				max-width: 760px;
				font-size: clamp(0.98rem, 2vw, 1.12rem);
				line-height: 1.5;
				color: rgba(46, 31, 23, 0.86);
			}

			.badge {
				display: inline-flex;
				margin-top: 1rem;
				padding: 0.45rem 0.75rem;
				font-size: 0.82rem;
				font-weight: 700;
				border: 1px solid rgba(47, 123, 106, 0.6);
				background: rgba(47, 123, 106, 0.12);
				color: #22584c;
			}

			.cta-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin-top: 1.3rem;
			}

			.cta {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				text-decoration: none;
				padding: 0.55rem 0.95rem;
				font-weight: 800;
				font-size: 0.84rem;
				border: 1px solid rgba(46, 31, 23, 0.25);
				background: rgba(255, 255, 255, 0.55);
				color: #2e1f17;
				transition: all 0.2s ease;
			}

			.cta.primary {
				background: linear-gradient(140deg, #2f7b6a, #266558);
				color: #f8edd3;
				border-color: rgba(46, 31, 23, 0.35);
			}

			.cta:hover {
				transform: translateY(-2px);
				box-shadow: 0 10px 16px rgba(46, 31, 23, 0.14);
			}

			.focus-panel {
				margin-top: 1.2rem;
				padding: 1rem;
				border: 1px solid rgba(142, 63, 42, 0.4);
				background: rgba(255, 249, 235, 0.68);
			}

			.focus-panel h2 {
				margin: 0;
				font-family: 'Cinzel', 'Georgia', serif;
				font-size: 1.1rem;
				letter-spacing: 0.04em;
				color: #8e3f2a;
			}

			.focus-list {
				margin: 0.65rem 0 0;
				padding-left: 1.05rem;
				display: grid;
				gap: 0.5rem;
			}

			.focus-list li {
				line-height: 1.45;
				color: rgba(46, 31, 23, 0.87);
			}

			@media (max-width: 720px) {
				.hero {
					padding: 1.1rem;
				}

				.cta {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<div class="flex flex-col min-h-screen">
			<Header />
			<main class="flex-1">
				<section class="hero">
					<div class="hero-content">
						<p class="kicker">{t.kicker}</p>
						<h1>{t.headline}</h1>
						<p class="subtitle">{t.subtitle}</p>
						<p class="badge">{t.badge}</p>

						<div class="cta-row">
							<a class="cta primary" href={withLang('/contact', lang)}>{t.primaryCta}</a>
							<a class="cta" href={withLang('/blog', lang)}>{t.secondaryCta}</a>
							<a class="cta" href={withLang('/about', lang)}>{t.thirdCta}</a>
						</div>

						<div class="focus-panel">
							<h2>{t.focusTitle}</h2>
							<ul class="focus-list">
								{t.focusItems.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
					</div>
				</section>
			</main>
			<Footer />
		</div>
	</body>
</html>
