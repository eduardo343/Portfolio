---
import { portfolioProjects } from '../data/projects';
import type { SiteLang } from '../utils/i18n';
import { withLang } from '../utils/i18n';

interface Props {
	lang: SiteLang;
}

const { lang } = Astro.props;

const copy = {
	es: {
		title: 'Proyectos En Piedra Y Codigo',
		subtitle: 'Navega los proyectos construidos juntos. Vista curada en estilo azteca claro.',
		level: 'Nivel',
		demo: 'Ver Demo',
		code: 'Codigo',
		caseStudy: 'Caso',
		progress: 'Progreso',
		hint: 'Usa flechas del teclado o desliza en movil',
		language: 'Idioma'
	},
	en: {
		title: 'Projects In Stone And Code',
		subtitle: 'Browse the projects we built together. Curated in a light Aztec visual style.',
		level: 'Level',
		demo: 'Live Demo',
		code: 'Code',
		caseStudy: 'Case',
		progress: 'Progress',
		hint: 'Use keyboard arrows or swipe on mobile',
		language: 'Language'
	}
} as const;

const t = copy[lang];
const totalProjects = portfolioProjects.length;

const esPath = withLang(Astro.url.pathname, 'es');
const enPath = withLang(Astro.url.pathname, 'en');
const localizeHref = (href: string) => withLang(href, lang);
---

<section class="aztec-projects" data-lang={lang}>
	<div class="sun-disc" aria-hidden="true"></div>
	<div class="glyph-grid" aria-hidden="true"></div>

	<div class="showcase-shell">
		<header class="showcase-header">
			<p class="section-kicker">{t.language}</p>
			<div class="language-switch" role="tablist" aria-label={t.language}>
				<a class:list={["lang-pill", { active: lang === 'es' }]} href={esPath}>ES</a>
				<a class:list={["lang-pill", { active: lang === 'en' }]} href={enPath}>EN</a>
			</div>
			<h1>{t.title}</h1>
			<p>{t.subtitle}</p>
		</header>

		<div class="slider-frame">
			<div class="frame-band top" aria-hidden="true"></div>
			<div class="frame-band bottom" aria-hidden="true"></div>

			<div class="projects-stage">
				{portfolioProjects.map((project, index) => (
					<article class:list={["project-card", { active: index === 0 }]} data-level={project.level}>
						<div class="project-sigil" aria-hidden="true">{project.glyph}</div>
						<div class="project-content">
							<p class="level-tag">
								{t.level} {String(project.level).padStart(2, '0')}
							</p>
							<h2>{project.title}</h2>
							<p class="project-summary">{project.summary[lang]}</p>

							<div class="project-links">
								{project.links.demo && (
									<a class="action-link demo" href={localizeHref(project.links.demo)} target="_blank" rel="noopener noreferrer">
										{t.demo}
									</a>
								)}
								{project.links.github && (
									<a class="action-link" href={localizeHref(project.links.github)} target="_blank" rel="noopener noreferrer">
										{t.code}
									</a>
								)}
								{project.links.caseStudy && (
									<a class="action-link" href={localizeHref(project.links.caseStudy)}>
										{t.caseStudy}
									</a>
								)}
							</div>

							<div class="stack-wrap">
								{project.stack.map((tech) => (
									<span class="stack-badge">{tech}</span>
								))}
							</div>
						</div>
					</article>
				))}
			</div>
		</div>

		<footer class="controls">
			<div class="meter">
				<span>{t.progress}</span>
				<div class="meter-track">
					<div class="meter-fill" id="meterFill"></div>
				</div>
			</div>

			<div class="counter">
				<span id="counterCurrent">01</span>
				<span>/</span>
				<span>{String(totalProjects).padStart(2, '0')}</span>
			</div>

			<div class="nav-actions">
				<button id="prevProject" aria-label="Previous project">◀</button>
				<button id="nextProject" aria-label="Next project">▶</button>
			</div>
		</footer>

		<p class="interaction-hint">{t.hint}</p>
	</div>
</section>

<script define:vars={{ totalProjects }}>
	class AztecProjectSlider {
		constructor() {
			this.current = 0;
			this.total = totalProjects;
			this.cards = Array.from(document.querySelectorAll('.project-card'));
			this.prev = document.getElementById('prevProject');
			this.next = document.getElementById('nextProject');
			this.fill = document.getElementById('meterFill');
			this.counter = document.getElementById('counterCurrent');
			this.frame = document.querySelector('.projects-stage');

			if (!this.cards.length || !this.prev || !this.next || !this.fill || !this.counter || !this.frame) {
				return;
			}

			this.bind();
			this.refresh();
		}

		bind() {
			this.prev.addEventListener('click', () => this.go(-1));
			this.next.addEventListener('click', () => this.go(1));

			document.addEventListener('keydown', (event) => {
				if (event.key === 'ArrowLeft') {
					event.preventDefault();
					this.go(-1);
				}
				if (event.key === 'ArrowRight') {
					event.preventDefault();
					this.go(1);
				}
			});

			let touchStartX = 0;
			this.frame.addEventListener('touchstart', (event) => {
				touchStartX = event.changedTouches[0].screenX;
			});

			this.frame.addEventListener('touchend', (event) => {
				const diff = touchStartX - event.changedTouches[0].screenX;
				if (Math.abs(diff) > 45) {
					this.go(diff > 0 ? 1 : -1);
				}
			});
		}

		go(direction) {
			const candidate = this.current + direction;
			if (candidate < 0 || candidate >= this.total) {
				return;
			}
			this.cards[this.current].classList.remove('active');
			this.current = candidate;
			this.cards[this.current].classList.add('active');
			this.refresh();
		}

		refresh() {
			const progress = ((this.current + 1) / this.total) * 100;
			this.fill.style.width = `${progress}%`;
			this.counter.textContent = String(this.current + 1).padStart(2, '0');
			this.prev.disabled = this.current === 0;
			this.next.disabled = this.current === this.total - 1;
		}
	}

	document.addEventListener('DOMContentLoaded', () => {
		new AztecProjectSlider();
	});
</script>

<style>
	.aztec-projects {
		--sand: #f8edd3;
		--sand-dark: #ead7b2;
		--obsidian: #2e1f17;
		--clay: #b35a3f;
		--clay-dark: #8e3f2a;
		--jade: #2f7b6a;
		--gold: #c3923a;
		position: relative;
		isolation: isolate;
		padding: clamp(1.2rem, 3vw, 2.8rem);
		min-height: 78vh;
		font-family: 'Manrope', 'Trebuchet MS', sans-serif;
		color: var(--obsidian);
		overflow: hidden;
	}

	.sun-disc {
		position: absolute;
		width: 280px;
		height: 280px;
		top: -120px;
		right: -80px;
		background: radial-gradient(circle at 30% 30%, #ffdc8f 0%, #d89b3f 60%, rgba(216, 155, 63, 0) 100%);
		opacity: 0.45;
		filter: blur(1px);
		z-index: -2;
	}

	.glyph-grid {
		position: absolute;
		inset: 0;
		background-image:
			repeating-linear-gradient(45deg, rgba(179, 90, 63, 0.1) 0 12px, transparent 12px 24px),
			repeating-linear-gradient(-45deg, rgba(47, 123, 106, 0.08) 0 10px, transparent 10px 20px);
		z-index: -1;
		opacity: 0.55;
	}

	.showcase-shell {
		position: relative;
		max-width: 1120px;
		margin: 0 auto;
		padding: clamp(1rem, 2vw, 2rem);
		border: 3px solid var(--clay-dark);
		background: linear-gradient(160deg, rgba(248, 237, 211, 0.96), rgba(238, 217, 178, 0.9));
		box-shadow:
			0 18px 40px rgba(89, 49, 36, 0.22),
			inset 0 0 0 2px rgba(195, 146, 58, 0.35);
	}

	.showcase-header {
		text-align: center;
		margin-bottom: 1.4rem;
	}

	.section-kicker {
		font-size: 0.78rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-weight: 700;
		color: var(--clay-dark);
		margin-bottom: 0.4rem;
	}

	.language-switch {
		display: inline-flex;
		gap: 0.45rem;
		padding: 0.3rem;
		background: rgba(179, 90, 63, 0.1);
		border: 1px solid rgba(142, 63, 42, 0.45);
		margin-bottom: 0.8rem;
	}

	.lang-pill {
		padding: 0.35rem 0.75rem;
		border: 1px solid transparent;
		text-decoration: none;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--obsidian);
		transition: all 0.2s ease;
	}

	.lang-pill.active {
		background: var(--jade);
		color: #fff8eb;
		border-color: rgba(0, 0, 0, 0.2);
	}

	.showcase-header h1 {
		font-family: 'Cinzel', 'Palatino Linotype', serif;
		font-size: clamp(1.6rem, 3vw, 2.6rem);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--clay-dark);
		margin: 0;
	}

	.showcase-header p {
		max-width: 760px;
		margin: 0.7rem auto 0;
		color: rgba(46, 31, 23, 0.84);
		line-height: 1.5;
	}

	.slider-frame {
		position: relative;
		background: linear-gradient(180deg, var(--sand) 0%, #f2dfbc 100%);
		border: 2px solid rgba(46, 31, 23, 0.25);
		padding: 1.3rem;
		overflow: hidden;
		min-height: 390px;
	}

	.frame-band {
		position: absolute;
		left: 0;
		right: 0;
		height: 12px;
		background:
			repeating-linear-gradient(90deg, var(--clay) 0 18px, transparent 18px 36px),
			repeating-linear-gradient(-45deg, rgba(0, 0, 0, 0.16) 0 6px, transparent 6px 12px);
		opacity: 0.5;
	}

	.frame-band.top {
		top: 0;
	}

	.frame-band.bottom {
		bottom: 0;
	}

	.projects-stage {
		position: relative;
		min-height: 340px;
	}

	.project-card {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: 160px 1fr;
		gap: 1.2rem;
		align-items: center;
		opacity: 0;
		transform: translateX(30px);
		transition: transform 0.28s ease, opacity 0.28s ease;
		pointer-events: none;
	}

	.project-card.active {
		opacity: 1;
		transform: translateX(0);
		pointer-events: auto;
	}

	.project-sigil {
		display: grid;
		place-items: center;
		font-size: clamp(2.8rem, 4vw, 4rem);
		width: 130px;
		height: 130px;
		margin: 0 auto;
		border: 2px solid rgba(142, 63, 42, 0.6);
		background:
			radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.55), transparent 62%),
			linear-gradient(145deg, #eecf97, #d4a95f);
		box-shadow: inset 0 0 0 4px rgba(46, 31, 23, 0.1);
		animation: sigil-float 2.4s ease-in-out infinite alternate;
	}

	@keyframes sigil-float {
		from {
			transform: translateY(-2px);
		}
		to {
			transform: translateY(6px);
		}
	}

	.project-content h2 {
		font-family: 'Cinzel', 'Georgia', serif;
		font-size: clamp(1.3rem, 2vw, 1.9rem);
		margin: 0.3rem 0 0.7rem;
		color: var(--clay-dark);
	}

	.level-tag {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--jade);
		margin: 0;
	}

	.project-summary {
		margin: 0;
		line-height: 1.55;
		font-size: 0.98rem;
		color: rgba(46, 31, 23, 0.9);
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-top: 1rem;
	}

	.action-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.45rem 0.85rem;
		text-decoration: none;
		border: 1px solid rgba(46, 31, 23, 0.4);
		font-weight: 700;
		font-size: 0.82rem;
		color: var(--obsidian);
		background: rgba(248, 237, 211, 0.8);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.action-link.demo {
		background: rgba(47, 123, 106, 0.14);
		border-color: rgba(47, 123, 106, 0.65);
	}

	.action-link:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 14px rgba(46, 31, 23, 0.15);
	}

	.stack-wrap {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.stack-badge {
		padding: 0.3rem 0.6rem;
		border: 1px solid rgba(179, 90, 63, 0.5);
		background: rgba(255, 247, 227, 0.7);
		font-size: 0.75rem;
		font-weight: 600;
		color: rgba(46, 31, 23, 0.82);
	}

	.controls {
		display: grid;
		grid-template-columns: 1fr auto auto;
		gap: 1rem;
		align-items: center;
		margin-top: 1.2rem;
	}

	.meter {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		font-size: 0.76rem;
		font-weight: 700;
		color: var(--jade);
		text-transform: uppercase;
	}

	.meter-track {
		width: min(300px, 100%);
		height: 10px;
		border: 1px solid rgba(46, 31, 23, 0.32);
		background: rgba(255, 255, 255, 0.35);
	}

	.meter-fill {
		height: 100%;
		width: 16.7%;
		background: linear-gradient(90deg, var(--clay), var(--gold));
		transition: width 0.26s ease;
	}

	.counter {
		display: flex;
		gap: 0.32rem;
		font-size: 1.1rem;
		font-weight: 800;
		color: var(--clay-dark);
		min-width: 72px;
		justify-content: center;
	}

	.nav-actions {
		display: flex;
		gap: 0.45rem;
	}

	.nav-actions button {
		width: 44px;
		height: 44px;
		border: 1px solid rgba(46, 31, 23, 0.35);
		background: linear-gradient(160deg, #f5dfb6, #e3bc7f);
		color: var(--clay-dark);
		font-size: 1rem;
		cursor: pointer;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.nav-actions button:hover:not(:disabled) {
		transform: translateY(-2px);
	}

	.nav-actions button:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}

	.interaction-hint {
		text-align: right;
		font-size: 0.78rem;
		margin-top: 0.85rem;
		color: rgba(46, 31, 23, 0.7);
	}

	@media (max-width: 900px) {
		.project-card {
			grid-template-columns: 1fr;
			align-items: start;
			gap: 0.85rem;
		}

		.project-sigil {
			width: 92px;
			height: 92px;
			font-size: 2.4rem;
		}

		.slider-frame {
			min-height: 510px;
		}

		.projects-stage {
			min-height: 448px;
		}
	}

	@media (max-width: 640px) {
		.controls {
			grid-template-columns: 1fr;
		}

		.interaction-hint {
			text-align: left;
		}

		.meter {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
