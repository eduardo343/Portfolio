---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
	keywords?: string;
	author?: string;
	type?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { 
	title, 
	description, 
	image = '/me.jpg',
	keywords = 'Alan Ugarte, Full Stack Developer, Laravel 11, Angular 19, PHP 8.2, TypeScript 5.0, MongoDB, Firebase, NoSQL, Web Development, Software Engineer',
	author = 'Alan Ugarte',
	type = 'website'
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content={author} />
<meta name="robots" content="index, follow" />
<meta name="language" content="English" />
<meta name="theme-color" content="#00ff41" />

<!-- Enhanced SEO Meta Tags -->
<meta name="classification" content="Full Stack Developer Portfolio" />
<meta name="subject" content="Web Development, Software Engineering, Laravel, Angular" />
<meta name="designer" content="Alan Ugarte" />
<meta name="owner" content="Alan Ugarte" />
<meta name="url" content={canonicalURL} />
<meta name="identifier-URL" content={canonicalURL} />
<meta name="directory" content="submission" />
<meta name="category" content="Technology, Web Development, Portfolio" />
<meta name="coverage" content="Worldwide" />
<meta name="distribution" content="Global" />
<meta name="rating" content="General" />
<meta name="revisit-after" content="7 days" />
<meta name="target" content="all" />
<meta name="HandheldFriendly" content="True" />
<meta name="MobileOptimized" content="320" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Alan Ugarte",
  "url": "https://alanugarte.dev",
  "image": "https://alanugarte.dev/me.jpg",
  "sameAs": [
    "https://github.com/alanugarte",
    "https://linkedin.com/in/alanugarte"
  ],
  "jobTitle": "Full Stack Developer",
  "worksFor": {
    "@type": "Organization",
    "name": "Freelance"
  },
  "knowsAbout": [
    "Laravel 11",
    "Angular 19",
    "PHP 8.2",
    "TypeScript 5.0",
    "MongoDB",
    "Firebase Firestore",
    "Web Development",
    "Full Stack Development"
  ],
  "description": "Passionate Full Stack Developer specializing in Laravel, Angular, and NoSQL databases with over 5 years of professional experience."
}
</script>

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="og:image:alt" content={`${author} - Full Stack Developer`} />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="Alan Ugarte Portfolio" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.url)} />
<meta name="twitter:image:alt" content={`${author} - Full Stack Developer`} />
<meta name="twitter:creator" content="@alanugarte" />
<meta name="twitter:site" content="@alanugarte" />

<script is:inline>
	(() => {
		const STORAGE_KEY = 'terminal-lang';
		const aliases = {
			esp: 'es',
			espanol: 'es',
			eng: 'en',
			english: 'en'
		};
		const supported = new Set(['es', 'en']);

		const normalize = (rawValue) => {
			if (typeof rawValue !== 'string') return '';
			const normalized = rawValue.trim().toLowerCase();
			return aliases[normalized] || normalized;
		};

		const resolve = (rawValue) => {
			const candidate = normalize(rawValue);
			return supported.has(candidate) ? candidate : '';
		};

		const readStoredLang = () => {
			try {
				return localStorage.getItem(STORAGE_KEY);
			} catch {
				return '';
			}
		};

		const storeLang = (lang) => {
			try {
				localStorage.setItem(STORAGE_KEY, lang);
			} catch {
				// Ignore storage write errors
			}
		};

		const readQueryLang = () => {
			const params = new URLSearchParams(window.location.search);
			return resolve(params.get('lang'));
		};

		const syncInternalLinks = (lang) => {
			document.querySelectorAll('a[href^="/"]').forEach((anchor) => {
				const href = anchor.getAttribute('href');
				if (!href || href.startsWith('//')) return;
				const url = new URL(href, window.location.origin);
				url.searchParams.set('lang', lang);
				anchor.setAttribute('href', `${url.pathname}${url.search}${url.hash}`);
			});
		};

		const syncUrl = (lang) => {
			const url = new URL(window.location.href);
			if (url.searchParams.get('lang') === lang) return;
			url.searchParams.set('lang', lang);
			history.replaceState(history.state ?? {}, '', `${url.pathname}${url.search}${url.hash}`);
		};

		const getLang = () => {
			return (
				readQueryLang() ||
				resolve(readStoredLang()) ||
				resolve(document.documentElement.getAttribute('lang')) ||
				'es'
			);
		};

		const applyTranslations = (root, dictionaries, lang) => {
			if (!root || !dictionaries) return;
			const messages = dictionaries[lang] || dictionaries.es || {};

			root.querySelectorAll('[data-i18n]').forEach((node) => {
				const key = node.getAttribute('data-i18n');
				const value = key ? messages[key] : '';
				if (typeof value === 'string') node.textContent = value;
			});

			root.querySelectorAll('[data-i18n-html]').forEach((node) => {
				const key = node.getAttribute('data-i18n-html');
				const value = key ? messages[key] : '';
				if (typeof value === 'string') node.innerHTML = value;
			});

			root.querySelectorAll('[data-i18n-placeholder]').forEach((node) => {
				const key = node.getAttribute('data-i18n-placeholder');
				const value = key ? messages[key] : '';
				if (typeof value === 'string') node.setAttribute('placeholder', value);
			});

			root.querySelectorAll('[data-i18n-aria-label]').forEach((node) => {
				const key = node.getAttribute('data-i18n-aria-label');
				const value = key ? messages[key] : '';
				if (typeof value === 'string') node.setAttribute('aria-label', value);
			});
		};

		const setLang = (rawLang, options = {}) => {
			const lang = resolve(rawLang) || getLang();
			const { emit = true, updateUrl = true, updateStorage = true } = options;

			document.documentElement.lang = lang;
			if (updateStorage) storeLang(lang);
			if (updateUrl) syncUrl(lang);
			syncInternalLinks(lang);

			if (emit) {
				window.dispatchEvent(new CustomEvent('portfolio-lang-change', { detail: lang }));
			}

			return lang;
		};

		window.portfolioLanguage = {
			resolve,
			getLang,
			setLang,
			applyTranslations
		};

		const initialLang = getLang();
		setLang(initialLang, { emit: false, updateUrl: true, updateStorage: true });
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', () => {
				syncInternalLinks(getLang());
			});
		} else {
			syncInternalLinks(getLang());
		}
	})();
</script>
