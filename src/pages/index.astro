---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TerminalPortfolio from '../components/TerminalPortfolio.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800&family=Press+Start+2P&display=swap" rel="stylesheet" />
		<style>
			body {
				margin: 0;
				min-height: 100vh;
				background: #000;
				color: #fff;
				font-family: 'Orbitron', sans-serif;
			}

			body::before {
				content: '';
				position: fixed;
				inset: 0;
				background: repeating-linear-gradient(0deg, transparent 0 2px, rgba(255, 255, 255, 0.04) 2px 4px);
				pointer-events: none;
			}

			main {
				position: relative;
				z-index: 1;
				padding: 0.8rem 0 2rem;
			}

			.hero-note {
				max-width: 1020px;
				margin: 0 auto 0.7rem;
				padding: 0 1rem;
			}

			.hero-note p {
				margin: 0;
				font-family: 'Press Start 2P', monospace;
				font-size: 0.46rem;
				line-height: 1.6;
				color: #fff;
				text-transform: uppercase;
			}
		</style>
	</head>
	<body>
		<div class="flex flex-col min-h-screen">
			<Header />
			<main class="flex-1">
				<div class="hero-note">
					<p data-i18n="home.note">Interactive terminal mode enabled</p>
				</div>
				<TerminalPortfolio />
			</main>
			<Footer />
		</div>
		<script is:inline>
			(() => {
				const root = document.querySelector('.hero-note');
				const languageApi = window.portfolioLanguage;
				if (!root || !languageApi) return;

				const translations = {
					es: {
						'home.note': 'Modo terminal interactivo activado'
					},
					en: {
						'home.note': 'Interactive terminal mode enabled'
					}
				};

				const render = (lang) => {
					languageApi.applyTranslations(root, translations, lang);
				};

				render(languageApi.getLang());
				window.addEventListener('portfolio-lang-change', (event) => {
					render(event.detail);
				});
			})();
		</script>
	</body>
</html>
