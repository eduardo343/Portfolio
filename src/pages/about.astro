---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLang } from '../utils/i18n';

const lang = getLang(Astro.url);

const copy = {
	es: {
		title: 'Acerca de mi | Alan Ugarte',
		description: 'Trayectoria y enfoque como desarrollador full stack.',
		header: 'Perfil Profesional',
		introTitle: 'Mision',
		introText1: 'Soy Alan Ugarte, desarrollador full stack con enfoque practico en producto, arquitectura y experiencia de usuario.',
		introText2: 'Desde mis primeras lineas de C++ hasta proyectos actuales en Laravel y Angular, mantengo una forma de trabajo orientada a resultados medibles.',
		expTitle: 'Experiencia',
		skillsTitle: 'Stack Tecnico',
		mindsetTitle: 'Forma de trabajo',
		mindsetText1: 'Priorizo codigo mantenible, decisiones tecnicas justificadas y comunicacion clara con negocio y producto.',
		mindsetText2: 'Me interesa construir software que crezca sin friccion: buen rendimiento, seguridad base y entregas iterativas.',
		categories: {
			backend: 'Backend',
			frontend: 'Frontend',
			data: 'Bases de Datos',
			tools: 'Herramientas'
		},
		timeline: [
			{
				period: '2024 - Actual',
				role: 'Freelancer',
				desc: 'Desarrollo de aplicaciones web end-to-end con foco en performance, escalabilidad y experiencia final.'
			},
			{
				period: '2024',
				role: 'Geem Solutions',
				desc: 'Implementacion de sistemas punto de venta con PHP y React, mejorando flujo operativo y estabilidad.'
			},
			{
				period: '2023 - 2024',
				role: 'Magmalabs',
				desc: 'Inicio profesional en desarrollo full stack participando en productos web para equipos y comunidades.'
			}
		]
	},
	en: {
		title: 'About Me | Alan Ugarte',
		description: 'Professional background and approach as a full-stack developer.',
		header: 'Professional Profile',
		introTitle: 'Mission',
		introText1: 'I am Alan Ugarte, a full-stack developer focused on product execution, architecture, and user experience.',
		introText2: 'From my first C++ lines to current Laravel and Angular projects, I keep a practical workflow driven by measurable outcomes.',
		expTitle: 'Experience',
		skillsTitle: 'Technical Stack',
		mindsetTitle: 'Working Style',
		mindsetText1: 'I prioritize maintainable code, well-justified technical decisions, and clear communication with business and product teams.',
		mindsetText2: 'I aim to build software that scales without friction: strong performance, baseline security, and iterative delivery.',
		categories: {
			backend: 'Backend',
			frontend: 'Frontend',
			data: 'Databases',
			tools: 'Tooling'
		},
		timeline: [
			{
				period: '2024 - Present',
				role: 'Freelancer',
				desc: 'End-to-end web product development with a focus on performance, scalability, and real user impact.'
			},
			{
				period: '2024',
				role: 'Geem Solutions',
				desc: 'Point-of-sale systems using PHP and React, improving operational flow and product reliability.'
			},
			{
				period: '2023 - 2024',
				role: 'Magmalabs',
				desc: 'Started professional full-stack work building web products for internal teams and user communities.'
			}
		]
	}
} as const;

const t = copy[lang];

const skills = {
	backend: ['Laravel 11', 'PHP 8.2', 'Node.js', 'REST APIs', 'GraphQL'],
	frontend: ['Angular 19', 'TypeScript', 'JavaScript', 'HTML/CSS', 'Tailwind CSS'],
	data: ['MongoDB', 'Firebase', 'DynamoDB', 'MySQL', 'Redis'],
	tools: ['Git', 'Docker', 'AWS', 'CI/CD', 'Agile']
} as const;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={t.title} description={t.description} />
		<style>
			body {
				margin: 0;
				min-height: 100vh;
				font-family: 'Manrope', 'Segoe UI', sans-serif;
				background:
					radial-gradient(circle at 9% 2%, rgba(227, 174, 92, 0.23), transparent 42%),
					radial-gradient(circle at 92% 16%, rgba(47, 123, 106, 0.16), transparent 36%),
					linear-gradient(180deg, #fbf2de 0%, #f1dfbb 100%);
				color: #2e1f17;
			}

			main {
				max-width: 1120px;
				margin: 0 auto;
				padding: 1.2rem 1rem 2.2rem;
				display: grid;
				gap: 1rem;
			}

			.section {
				border: 2px solid rgba(142, 63, 42, 0.5);
				background:
					repeating-linear-gradient(-45deg, rgba(179, 90, 63, 0.09) 0 12px, transparent 12px 24px),
					linear-gradient(160deg, rgba(250, 239, 215, 0.95), rgba(236, 214, 173, 0.9));
				padding: 1.05rem;
				box-shadow: 0 10px 24px rgba(89, 49, 36, 0.14);
			}

			h1,
			h2 {
				margin: 0;
				font-family: 'Cinzel', 'Georgia', serif;
				letter-spacing: 0.04em;
				color: #8e3f2a;
			}

			h1 {
				font-size: clamp(1.5rem, 2.9vw, 2.2rem);
			}

			h2 {
				font-size: 1.2rem;
			}

			.lead,
			.paragraph,
			.timeline-item,
			.skill-list {
				color: rgba(46, 31, 23, 0.88);
				line-height: 1.5;
			}

			.lead {
				margin-top: 0.65rem;
			}

			.paragraph {
				margin: 0.7rem 0 0;
			}

			.timeline {
				display: grid;
				gap: 0.7rem;
				margin-top: 0.8rem;
			}

			.timeline-item {
				padding: 0.7rem;
				border: 1px solid rgba(46, 31, 23, 0.2);
				background: rgba(255, 251, 241, 0.62);
			}

			.timeline-item strong {
				display: block;
				font-size: 0.78rem;
				color: #2f7b6a;
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}

			.timeline-item span {
				display: block;
				margin: 0.28rem 0;
				font-weight: 800;
				color: #8e3f2a;
			}

			.skills-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.7rem;
				margin-top: 0.7rem;
			}

			.skill-card {
				padding: 0.7rem;
				border: 1px solid rgba(46, 31, 23, 0.2);
				background: rgba(255, 251, 241, 0.65);
			}

			.skill-card h3 {
				margin: 0;
				font-size: 0.95rem;
				color: #2f7b6a;
			}

			.skill-list {
				margin: 0.45rem 0 0;
				font-size: 0.94rem;
			}

			@media (max-width: 760px) {
				.skills-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<div class="flex flex-col min-h-screen">
			<Header />
			<main class="flex-1">
				<section class="section">
					<h1>{t.header}</h1>
					<p class="lead">{t.introText1}</p>
					<p class="paragraph">{t.introText2}</p>
				</section>

				<section class="section">
					<h2>{t.expTitle}</h2>
					<div class="timeline">
						{t.timeline.map((entry) => (
							<article class="timeline-item">
								<strong>{entry.period}</strong>
								<span>{entry.role}</span>
								{entry.desc}
							</article>
						))}
					</div>
				</section>

				<section class="section">
					<h2>{t.skillsTitle}</h2>
					<div class="skills-grid">
						<div class="skill-card">
							<h3>{t.categories.backend}</h3>
							<p class="skill-list">{skills.backend.join(' • ')}</p>
						</div>
						<div class="skill-card">
							<h3>{t.categories.frontend}</h3>
							<p class="skill-list">{skills.frontend.join(' • ')}</p>
						</div>
						<div class="skill-card">
							<h3>{t.categories.data}</h3>
							<p class="skill-list">{skills.data.join(' • ')}</p>
						</div>
						<div class="skill-card">
							<h3>{t.categories.tools}</h3>
							<p class="skill-list">{skills.tools.join(' • ')}</p>
						</div>
					</div>
				</section>

				<section class="section">
					<h2>{t.mindsetTitle}</h2>
					<p class="paragraph">{t.mindsetText1}</p>
					<p class="paragraph">{t.mindsetText2}</p>
				</section>
			</main>
			<Footer />
		</div>
	</body>
</html>
