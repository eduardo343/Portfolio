---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<BaseHead title="About Alan Ugarte - Full Stack Developer" description="Learn about Alan Ugarte's journey as a Full Stack Developer specializing in Laravel, Angular, and NoSQL databases" />
		<!-- Import Press Start 2P font for consistency -->
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
		<style>
			/* Apply same retro background as homepage */
			body {
				background: 
					linear-gradient(45deg, #0f0f23 25%, transparent 25%), 
					linear-gradient(-45deg, #0f0f23 25%, transparent 25%), 
					linear-gradient(45deg, transparent 75%, #0f0f23 75%), 
					linear-gradient(-45deg, transparent 75%, #0f0f23 75%),
					linear-gradient(to bottom, #1a1a3a, #0f0f23);
				background-size: 20px 20px, 20px 20px, 20px 20px, 20px 20px, 100% 100%;
				background-position: 0 0, 0 10px, 10px -10px, -10px 0px, 0 0;
				color: #00ff41;
				font-family: 'Press Start 2P', monospace;
				min-height: 100vh;
				position: relative;
				overflow-x: hidden;
			}

			/* CRT scanlines effect */
			body::before {
				content: '';
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: repeating-linear-gradient(
					0deg,
					transparent,
					transparent 2px,
					rgba(0, 255, 65, 0.03) 2px,
					rgba(0, 255, 65, 0.03) 4px
				);
				pointer-events: none;
				z-index: 1000;
			}

			/* Main about container */
			.pixel-about {
				position: relative;
				padding: 2rem;
				max-width: 1000px;
				margin: 2rem auto;
			}

			/* About sections */
			.about-section {
				background: rgba(0, 0, 0, 0.4);
				border: 3px solid #330ce2;
				margin-bottom: 2rem;
				padding: 2rem;
				position: relative;
				box-shadow: 
					0 0 30px rgba(51, 12, 226, 0.3),
					inset 0 0 30px rgba(206, 205, 209, 0.1);
			}

			/* Rainbow border for sections */
			.about-section::before {
				content: '';
				position: absolute;
				top: -3px;
				left: -3px;
				right: -3px;
				bottom: -3px;
				background: linear-gradient(
					45deg,
					#ff0080, #141515, #0080ff, #ff0080
				);
				z-index: -1;
				animation: rainbow-border 3s linear infinite;
			}

			@keyframes rainbow-border {
				0% { background-position: 0% 50%; }
				50% { background-position: 100% 50%; }
				100% { background-position: 0% 50%; }
			}

			/* Section titles */
			.section-title {
				font-size: 1.5rem;
				color: #000000;
				margin-bottom: 1.5rem;
				text-align: center;
				text-shadow: 
					0 0 5px #6b17b4,
					0 0 10px #2429c8;
				animation: glitch 2s infinite;
			}

			/* Main title */
			.main-title {
				font-size: 2.5rem;
				color: #b020b5;
				text-align: center;
				margin-bottom: 3rem;
				text-shadow: 
					0 0 5px #00ff41,
					0 0 10px #00ff41,
					0 0 15px #00ff41;
				animation: glitch 2s infinite;
			}

			/* Glitch animation */
			@keyframes glitch {
				0%, 100% {
					text-shadow: 
						0 0 5px #00ff41,
						0 0 10px #00ff41,
						0 0 15px #00ff41;
				}
				25% {
					text-shadow: 
						-2px 0 #ff0080,
						2px 0 #0080ff,
						0 0 5px #00ff41;
				}
				50% {
					text-shadow: 
						2px 0 #ff0080,
						-2px 0 #0080ff,
						0 0 5px #00ff41;
				}
				75% {
					text-shadow: 
						0 0 5px #00ff41,
						0 0 10px #00ff41,
						0 0 15px #00ff41;
				}
			}

			/* Content text */
			.pixel-text {
				color: #f6f6f6;
				font-size: 0.8rem;
				line-height: 1.8;
				margin-bottom: 1.5rem;
				text-shadow: 1px 1px 0 #000000;
			}

			/* Timeline container */
			.timeline {
				position: relative;
				padding-left: 2rem;
			}

			.timeline::before {
				content: '';
				position: absolute;
				left: 0;
				top: 0;
				bottom: 0;
				width: 3px;
				background: linear-gradient(to bottom, #ff0080, #00ff41, #0080ff);
				border-radius: 2px;
			}

			/* Timeline items */
			.timeline-item {
				position: relative;
				margin-bottom: 2rem;
				padding-left: 2rem;
			}

			.timeline-item::before {
				content: '';
				position: absolute;
				left: -2rem;
				top: 0.5rem;
				width: 12px;
				height: 12px;
				background: #00ff41;
				border: 2px solid #ff0080;
				border-radius: 50%;
				box-shadow: 0 0 10px #00ff41;
			}

			.timeline-date {
				color: #0080ff;
				font-size: 0.7rem;
				font-weight: bold;
				margin-bottom: 0.5rem;
				text-shadow: 1px 1px 0 #004080;
			}

			.timeline-title {
				color: #00ff41;
				font-size: 0.9rem;
				margin-bottom: 0.5rem;
				text-shadow: 1px 1px 0 #00aa2e;
			}

			.timeline-desc {
				color: #f9f9f9;
				font-size: 0.7rem;
				line-height: 1.6;
				text-shadow: 1px 1px 0 #080708;
			}

			/* Skills grid */
			.skills-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 1rem;
				margin-top: 1rem;
			}

			.skill-category {
				background: rgba(0, 0, 0, 0.6);
				border: 2px solid #ff0080;
				padding: 1rem;
				text-align: center;
				transition: all 0.3s ease;
			}

			.skill-category:hover {
				border-color: #00ff41;
				box-shadow: 0 0 15px rgba(0, 255, 65, 0.5);
				transform: translateY(-2px);
			}

			.skill-title {
				color: #fbfbfb;
				font-size: 0.8rem;
				margin-bottom: 1rem;
				text-shadow: 1px 1px 0 #050505;
			}

			.skill-list {
				color: #eae7e9;
				font-size: 0.6rem;
				line-height: 1.8;
				text-shadow: 1px 1px 0 #000000;
			}

			/* Responsive design */
			@media (max-width: 768px) {
				.main-title {
					font-size: 1.8rem;
				}
				.section-title {
					font-size: 1.2rem;
				}
				.pixel-about {
					margin: 1rem;
					padding: 1rem;
				}
				.about-section {
					padding: 1.5rem;
				}
				.skills-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
		<style>
			body {
				background: #000 !important;
				color: #f5f5f5 !important;
				font-family: 'Space Grotesk', sans-serif !important;
			}

			body::before {
				display: none !important;
			}

			.pixel-about {
				max-width: 980px;
				margin: 1.2rem auto;
				padding: 1rem;
			}

			.main-title {
				margin-bottom: 1.2rem;
				font-family: 'Space Grotesk', sans-serif !important;
				font-size: clamp(1.4rem, 3vw, 2rem) !important;
				color: #f8fafc !important;
				text-align: left;
				animation: none !important;
				text-shadow: none !important;
			}

			.about-section {
				background: #040404 !important;
				border: 1px solid #1f1f1f !important;
				border-radius: 12px;
				box-shadow: none !important;
				padding: 1.1rem !important;
				margin-bottom: 0.9rem !important;
			}

			.about-section::before {
				display: none !important;
			}

			.section-title {
				font-family: 'IBM Plex Mono', ui-monospace, monospace !important;
				font-size: 0.92rem !important;
				letter-spacing: 0.04em;
				text-align: left !important;
				color: #22d3ee !important;
				margin-bottom: 0.9rem !important;
				animation: none !important;
				text-shadow: none !important;
			}

			.pixel-text {
				color: #d1d5db !important;
				font-family: 'IBM Plex Mono', ui-monospace, monospace !important;
				font-size: 0.9rem !important;
				line-height: 1.75 !important;
				margin-bottom: 1rem !important;
				text-shadow: none !important;
			}

			.timeline::before {
				background: #1f2937 !important;
			}

			.timeline-item::before {
				background: #22d3ee !important;
				border-color: #0e7490 !important;
				box-shadow: none !important;
			}

			.timeline-date {
				color: #94a3b8 !important;
				text-shadow: none !important;
			}

			.timeline-title {
				color: #f8fafc !important;
				text-shadow: none !important;
			}

			.timeline-desc {
				color: #cbd5e1 !important;
				text-shadow: none !important;
			}

			.skills-grid {
				gap: 0.75rem !important;
			}

			.skill-category {
				background: #060606 !important;
				border: 1px solid #1f1f1f !important;
				border-radius: 10px;
				transform: none !important;
				box-shadow: none !important;
			}

			.skill-category:hover {
				border-color: #334155 !important;
				box-shadow: none !important;
				transform: none !important;
			}

			.skill-title {
				color: #e2e8f0 !important;
				font-family: 'IBM Plex Mono', ui-monospace, monospace !important;
				font-size: 0.74rem !important;
				text-shadow: none !important;
			}

			.skill-list {
				color: #94a3b8 !important;
				font-family: 'IBM Plex Mono', ui-monospace, monospace !important;
				font-size: 0.72rem !important;
				line-height: 1.7 !important;
				text-shadow: none !important;
			}
		</style>
	</head>
	<body>
		<div class="flex flex-col min-h-screen">
			<Header />
			
				<main class="flex-1 px-4 py-8">
					<div class="pixel-about">
						<h1 class="main-title" data-i18n="about.mainTitle">👨‍💻 PLAYER PROFILE</h1>
						
						<!-- Introduction Section -->
						<section class="about-section">
							<h2 class="section-title" data-i18n="about.missionTitle">🎯 MISSION STATEMENT</h2>
							<p class="pixel-text" data-i18n="about.missionP1">
								¡Hola! I'm Alan Ugarte, a passionate Full Stack Developer with 3 years of professional experience crafting digital solutions. My journey began at age 15 with my first line of C++, and since then, I've been on an epic quest to master the art of programming.
							</p>
							<p class="pixel-text" data-i18n="about.missionP2">
								I specialize in building scalable web applications using modern technologies, with a strong focus on Node.js backends, React frontends, and NoSQL databases. My mission is to transform complex business requirements into elegant, efficient, and user-friendly solutions.
							</p>
						</section>

						<!-- Experience Timeline -->
						<section class="about-section">
							<h2 class="section-title" data-i18n="about.experienceTitle">🚀 EXPERIENCE LOG</h2>
							<div class="timeline">
								<div class="timeline-item">
									<div class="timeline-date" data-i18n="about.exp1.date">2024 - PRESENT</div>
									<div class="timeline-title" data-i18n="about.exp1.title">Freelancer</div>
									<div class="timeline-desc" data-i18n="about.exp1.desc">
										Trellcord: Full-stack app combining Trello-style task management and real-time Discord-style chat. JWT auth, drag-and-drop boards, WebSockets, CI/CD with Docker & GitHub Actions. Stack: React.js, Node.js, Socket.io, MongoDB.
Casino Fibonacci: Interactive Streamlit simulator for betting strategies (Fibonacci, Martingale, D'Alembert) with statistical analysis and 1000+ simulation runs. Stack: Python, Streamlit, Plotly, Pandas, NumPy.
Virtual Assistant: Intelligent assistant with NLP (spaCy/NLTK), conversational memory, predictive analytics and API integration. 85% intent accuracy, responses under 2 seconds. Stack: Python, Streamlit, spaCy, NLTK.
									</div>
								</div>
								<div class="timeline-item">
									<div class="timeline-date" data-i18n="about.exp2.date">2024</div>
									<div class="timeline-title" data-i18n="about.exp2.title">Geem Solutions</div>
									<div class="timeline-desc" data-i18n="about.exp2.desc">
										Developed and maintained a POS platform adopted by 50+ local businesses. Reduced security vulnerabilities by 40% and built a PHP remote lock system that improved debt recovery rates by 90%. Stack: PHP.
									</div>
								</div>
								<div class="timeline-item">
									<div class="timeline-date" data-i18n="about.exp3.date">2023 - 2024</div>
									<div class="timeline-title" data-i18n="about.exp3.title">Magmalabs</div>
									<div class="timeline-desc" data-i18n="about.exp3.desc">
										Bright-Coders: Built React (Redux) components and RESTful Rails API endpoints, boosting responsiveness by 30%. Optimized PostgreSQL queries reducing load times by 25% and improved test coverage with RSpec and Jest. Stack: React, Rails, PostgreSQL.
MagmaChat AI: Engineered FastAPI backend services for NLP pipelines, JWT auth, AWS S3 integration, and fine-tuned Hugging Face models achieving 20% accuracy improvement on financial tasks. Stack: Python, FastAPI, AWS, Hugging Face.
									</div>
								</div>
							</div>
						</section>

						<!-- Technical Skills -->
						<section class="about-section">
							<h2 class="section-title" data-i18n="about.skillsTitle">⚡ TECH ARSENAL</h2>
							<div class="skills-grid">
								<div class="skill-category">
									<div class="skill-title" data-i18n="about.skill.backend">🖥️ BACKEND</div>
									<div class="skill-list">
										PHP 8.2<br/>
										Laravel 11<br/>
									Node.js<br/>
									RESTful APIs<br/>
									GraphQL
									</div>
								</div>
								<div class="skill-category">
									<div class="skill-title" data-i18n="about.skill.frontend">🎨 FRONTEND</div>
									<div class="skill-list">
										TypeScript 5.0<br/>
									JavaScript ES6+<br/>
									HTML5 & CSS3<br/>
									Tailwind CSS<br/>
									React<br/>
									Next.js<br/>
									Astro
									</div>
								</div>
								<div class="skill-category">
									<div class="skill-title" data-i18n="about.skill.databases">🗄️ DATABASES</div>
									<div class="skill-list">
										MongoDB<br/>
										Firebase Firestore<br/>
									DynamoDB<br/>
									MySQL<br/>
									Redis
									</div>
								</div>
								<div class="skill-category">
									<div class="skill-title" data-i18n="about.skill.tools">🛠️ TOOLS & OTHERS</div>
									<div class="skill-list">
										Git & GitHub<br/>
										Docker<br/>
									Agile/Scrum<br/>
									CI/CD
								</div>
							</div>
						</div>
					</section>

						<!-- Philosophy & Interests -->
						<section class="about-section">
							<h2 class="section-title" data-i18n="about.philosophyTitle">💡 CODING PHILOSOPHY</h2>
							<p class="pixel-text" data-i18n="about.philosophyP1">
								I believe in writing clean, maintainable code that not only solves problems but also tells a story. My approach combines modern development practices with a deep understanding of business requirements to deliver solutions that truly matter.
							</p>
							<p class="pixel-text" data-i18n="about.philosophyP2">
								When I'm not coding, you'll find me contributing to open-source projects, participating in hackathons, mentoring junior developers, or exploring the latest industry trends. I'm passionate about sharing knowledge and believe that the best way to grow is by helping others succeed.
							</p>
							<p class="pixel-text" data-i18n="about.philosophyP3">
								Currently focused on mastering Node.js latest features, exploring React new capabilities, and diving deeper into NoSQL database optimization techniques.
							</p>
						</section>
					</div>
				</main>
			
				<Footer />
			</div>
