---
import { GITHUB_URL, LINKEDIN_URL, EMAIL } from '../consts';
import { getLang } from '../utils/i18n';

const today = new Date();
const lang = getLang(Astro.url);

const copy = {
	es: {
		title: 'Contacto',
		description: 'Disponible para colaboraciones, freelance y productos digitales.',
		built: 'Construido con Astro y enfoque full stack.'
	},
	en: {
		title: 'Contact',
		description: 'Available for collaborations, freelance, and digital product work.',
		built: 'Built with Astro and a full-stack mindset.'
	}
} as const;

const t = copy[lang];
const emailHref = `mailto:${EMAIL}`;
---

<footer class="aztec-footer">
	<div class="footer-grid">
		<section class="footer-card">
			<h3>{t.title}</h3>
			<p>{t.description}</p>
			<div class="footer-links">
				<a href={emailHref}>{EMAIL}</a>
				<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn</a>
				<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
			</div>
		</section>

		<section class="footer-card signature">
			<p>© {today.getFullYear()} Alan Ugarte</p>
			<p>{t.built}</p>
		</section>
	</div>
</footer>

<style>
	.aztec-footer {
		margin-top: auto;
		padding: 1.4rem 1rem 1.8rem;
		background:
			repeating-linear-gradient(45deg, rgba(179, 90, 63, 0.12) 0 14px, transparent 14px 28px),
			linear-gradient(180deg, rgba(240, 224, 193, 0.95), rgba(229, 208, 171, 0.96));
		border-top: 2px solid rgba(142, 63, 42, 0.5);
	}

	.footer-grid {
		max-width: 1120px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: 1rem;
	}

	.footer-card {
		border: 1px solid rgba(46, 31, 23, 0.25);
		background: rgba(255, 248, 231, 0.7);
		padding: 0.9rem;
	}

	.footer-card h3 {
		margin: 0;
		font-family: 'Cinzel', 'Georgia', serif;
		font-size: 1rem;
		letter-spacing: 0.05em;
		color: #8e3f2a;
	}

	.footer-card p {
		margin: 0.4rem 0 0;
		font-size: 0.86rem;
		line-height: 1.4;
		color: rgba(46, 31, 23, 0.84);
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.7rem;
	}

	.footer-links a {
		text-decoration: none;
		padding: 0.33rem 0.58rem;
		border: 1px solid rgba(46, 31, 23, 0.2);
		font-size: 0.78rem;
		font-weight: 700;
		background: rgba(255, 255, 255, 0.56);
		color: rgba(46, 31, 23, 0.9);
	}

	.footer-links a:hover {
		border-color: rgba(47, 123, 106, 0.7);
		background: rgba(47, 123, 106, 0.14);
	}

	.signature {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	@media (max-width: 768px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
