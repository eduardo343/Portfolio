---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href = '#', class: className, ...props } = Astro.props;

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const hrefPath = new URL(String(href), Astro.url).pathname.replace(import.meta.env.BASE_URL, '');

const isActive = hrefPath === pathname || hrefPath === '/' + (subpath?.[0] || '');
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>

<style>
	a {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	a.active {
		background: rgba(47, 123, 106, 0.16) !important;
		border-color: rgba(47, 123, 106, 0.75) !important;
		color: #2e1f17 !important;
		box-shadow: inset 0 0 0 1px rgba(47, 123, 106, 0.2);
	}
</style>
