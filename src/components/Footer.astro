---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-inner" data-year={today.getFullYear()}>
		<p class="footer-copy" data-i18n="footer.copy">© {today.getFullYear()} Alan Ugarte • Built with focus and coffee</p>
		<p class="footer-powered" data-i18n="footer.powered">Powered by Astro</p>
	</div>
</footer>

<script is:inline>
	(() => {
		const root = document.querySelector('.site-footer');
		const languageApi = window.portfolioLanguage;
		if (!root || !languageApi) return;

		const year = root.querySelector('[data-year]')?.getAttribute('data-year') || String(new Date().getFullYear());
		const translations = {
			es: {
				'footer.copy': `© ${year} Alan Ugarte • Hecho con enfoque y café`,
				'footer.powered': 'Impulsado por Astro'
			},
			en: {
				'footer.copy': `© ${year} Alan Ugarte • Built with focus and coffee`,
				'footer.powered': 'Powered by Astro'
			}
		};

		const activeLang = languageApi.getLang();
		const currentMessages = languageApi.captureTranslations?.(root) || {};
		translations[activeLang] = {
			...(translations[activeLang] || {}),
			...currentMessages
		};

		const render = (lang) => {
			languageApi.applyTranslations(root, translations, lang);
		};

		render(activeLang);
		window.addEventListener('portfolio-lang-change', (event) => {
			render(event.detail);
		});
	})();
</script>

<style>
	.site-footer {
		border-top: 1px solid #1f1f1f;
		background: #020202;
	}

	.footer-inner {
		max-width: 1120px;
		margin: 0 auto;
		padding: 1rem;
		text-align: center;
	}

	.footer-copy {
		margin: 0;
		color: #d1d5db;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.78rem;
		line-height: 1.45;
	}

	.footer-powered {
		margin: 0.25rem 0 0;
		color: #9ca3af;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.74rem;
	}
</style>
