---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
		<style>
			body {
				background: linear-gradient(to bottom, #ccc, #fff);
				color: #1100ff;
				font-family: 'Press Start 2P', monospace;
			}

			h1 {
				text-shadow: 2px 2px 0 #000;
			}

			.pixel-button {
				display: inline-block;
				padding: 0.75rem 1.5rem;
				border: 4px solid #00ff00;
				background-color: black;
				color: #00ff00;
				text-decoration: none;
				transition: background-color 0.3s, color 0.3s;
			}

			.pixel-button:hover {
				background-color: #00ff00;
				color: black;
			}
		</style>
	</head>
	<body class="flex flex-col min-h-screen">
		<Header />
		<main class="flex-1 flex flex-col items-center justify-center px-4 py-8">
			<h1>👾 ¡Hello there! My name is Alan</h1>
			<p class="mt-4 text-center text-green-500">
				Web developer with a passion for retro style and digital experiences.
			</p>
			<a href="/contact" class="pixel-button mt-6">Contact Me</a>
		</main>
		<Footer class="py-6 bg-black text-center text-green-500" />
	</body>
</html>
