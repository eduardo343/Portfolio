---
// Import type definitions for HTML anchor element attributes
import type { HTMLAttributes } from 'astro/types';

// Define component props extending standard HTML anchor attributes
type Props = HTMLAttributes<'a'>;

// Destructure props: extract href, class (renamed to className), and spread remaining props
const { href, class: className, ...props } = Astro.props;

// Get current pathname and remove base URL if present (for deployment in subdirectories)
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');

// Extract path segments (split by '/') for comparison
const subpath = pathname.match(/[^\/]+/g);

// Determine if this link should be marked as active:
// - Exact match with current pathname, OR
// - Link is '/' and we're on root, OR  
// - Link matches first path segment (e.g., '/blog' matches '/blog/post-1')
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	a.active {
		background-color: #0f0f0f !important;
		border-color: #22d3ee !important;
		color: #ffffff !important;
		box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.2);
	}
</style>
