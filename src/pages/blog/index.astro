---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Datos de los proyectos - Edita aquí tus proyectos reales
const projects = [
	{
		level: 1,
		emoji: '💪',
		title: 'Fitness Assistant',
		description: 'This fitness assistant application provides personalized workout plans, nutrition tracking, and progress monitoring to help users achieve their fitness goals effectively.',
		techs: [
			{ name: 'Python', class: 'python' },
			{ name: 'Streamlit', class: 'streamlit' },
		],
		links: {
			demo: 'https://fitness-assistant-vwbd5v4xbajjwfetfufbmc.streamlit.app/',
			github: 'https://github.com/eduardo343/Fitness-Assistant.git'
		}
	},
	{
		level: 2,
		emoji: '📱',
		title: 'Trellcord',
		description: 'Trellcord is a mobile app that combines task management and team communication, allowing users to create tasks, assign them to team members, and chat in real-time within the same platform.',
		techs: [
			{ name: 'REACT', class: 'react' },
			{ name: 'NODE', class: 'node' },
			{ name: 'MONGO', class: 'mongo' }
		],
		links: {
			demo: 'https://vercel.com/eduardo343s-projects/trellcord/2HNeVJDFudXECzcAz2vLFUzRQCrS',
			github: 'https://github.com/eduardo343/Trellcord.git'
		}
	},
	{
		level: 3,
		emoji: '🎰',
		title: 'CASINO TESTING APP',
		description: 'App móvil con seguimiento GPS, métricas de salud, retos sociales y integración con dispositivos wearables.',
		techs: [
			{ name: 'Python', class: 'python' },
			{ name: 'Streamlit', class: 'streamlit' },
			{ name: 'REST', class: 'api' }
		],
		links: {
			demo: 'https://casino-testing.streamlit.app/',
			github: 'https://github.com/eduardo343/Casino-Testing-.git'
		}
	},
	{
		level: 4,
		emoji: '🧠',
		title: 'AI IMAGE GENERATOR',
		description: 'Generador de imágenes con IA usando modelos de difusión. Interface web intuitiva con historial y personalización avanzada.',
		techs: [
			{ name: 'PYTHON', class: 'python' },
			{ name: 'AI/ML', class: 'ai' },
			{ name: 'DOCKER', class: 'docker' }
		],
		links: {
			demo: 'https://tu-ai-demo.com',
			github: 'https://github.com/tu-usuario/ai-generator'
		}
	},
	{
		level: 5,
		emoji: '🎵',
		title: 'MUSIC STREAMING PLATFORM',
		description: 'Plataforma de streaming con recomendaciones IA, playlists colaborativas y reproductor con visualizador de ondas.',
		techs: [
			{ name: 'VUE', class: 'vue' },
			{ name: 'NODE', class: 'node' },
			{ name: 'PSQL', class: 'postgres' }
		],
		links: {
			demo: 'https://tu-music-platform.com'
		}
	},
	{
		level: 6,
		emoji: '⚡',
		title: 'BLOCKCHAIN WALLET',
		description: 'Cartera de criptomonedas multi-chain con intercambio DEX, staking y portfolio tracking. Seguridad de grado bancario.',
		techs: [
			{ name: 'SOL', class: 'solidity' },
			{ name: 'WEB3', class: 'web3' },
			{ name: 'NEXT', class: 'next' }
		],
		links: {
			demo: 'https://tu-wallet-demo.com',
			github: 'https://github.com/tu-usuario/blockchain-wallet'
		}
	}
];

const totalProjects = projects.length;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title="Portfolio - Alan Ugarte" description="Retro gaming portfolio showcasing full stack development projects" />
		<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
		<style>
			:root {
				--neon-green: #00ff41;
				--neon-cyan: #00ffff;
				--neon-magenta: #ff0080;
				--neon-yellow: #ffff00;
				--dark-bg: #0a0a0a;
				--console-bg: #1a1a1a;
				--screen-bg: #000814;
				--border-thick: 8px;
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				font-family: 'Press Start 2P', monospace;
				background: var(--dark-bg);
				color: var(--neon-green);
				min-height: 100vh;
				position: relative;
			}

			.retro-grid {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: linear-gradient(transparent 90%, var(--neon-cyan) 90%),
							linear-gradient(90deg, transparent 90%, var(--neon-cyan) 90%);
				background-size: 50px 50px;
				animation: grid-move 20s linear infinite;
				opacity: 0.1;
				z-index: 1;
				transform: perspective(800px) rotateX(60deg) translateZ(-200px);
			}

			@keyframes grid-move {
				0% { transform: perspective(800px) rotateX(60deg) translateZ(-200px) translateY(0); }
				100% { transform: perspective(800px) rotateX(60deg) translateZ(-200px) translateY(50px); }
			}

			.stars-container {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				z-index: 2;
				pointer-events: none;
			}

			.scanlines {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: repeating-linear-gradient(
					0deg,
					transparent,
					transparent 2px,
					rgba(0, 255, 65, 0.03) 2px,
					rgba(0, 255, 65, 0.03) 4px
				);
				pointer-events: none;
				z-index: 10;
			}

			.portfolio-wrapper {
				position: relative;
				z-index: 5;
				padding: 2rem 0;
			}

			.console {
				width: 95%;
				max-width: 1200px;
				margin: 0 auto;
				background: var(--console-bg);
				border: var(--border-thick) solid var(--neon-cyan);
				border-radius: 20px;
				box-shadow: 
					0 0 20px var(--neon-cyan),
					inset 0 0 20px rgba(0, 255, 255, 0.1);
				display: flex;
				flex-direction: column;
			}

			.console-leds {
				display: flex;
				gap: 15px;
				padding: 20px;
				justify-content: center;
			}

			.led {
				width: 12px;
				height: 12px;
				border-radius: 50%;
				border: 2px solid #333;
			}

			.led-power {
				background: var(--neon-green);
				box-shadow: 0 0 10px var(--neon-green);
				animation: pulse 2s infinite;
			}

			.led-data {
				background: var(--neon-yellow);
				box-shadow: 0 0 10px var(--neon-yellow);
				animation: pulse 1.5s infinite;
			}

			.led-system {
				background: var(--neon-magenta);
				box-shadow: 0 0 10px var(--neon-magenta);
				animation: pulse 3s infinite;
			}

			@keyframes pulse {
				0%, 100% { opacity: 1; }
				50% { opacity: 0.3; }
			}

			.screen {
				margin: 0 30px;
				background: var(--screen-bg);
				border: 6px solid #333;
				border-radius: 15px;
				min-height: 600px;
				overflow: hidden;
				box-shadow: inset 0 0 50px rgba(0, 0, 0, 0.8);
			}

			.screen-content {
				padding: 40px;
				position: relative;
				z-index: 3;
			}

			.title-section {
				text-align: center;
				margin-bottom: 40px;
			}

			.glitch-title {
				font-size: 2.5rem;
				color: var(--neon-green);
				text-shadow: 
					2px 2px 0px var(--neon-magenta),
					-2px -2px 0px var(--neon-cyan);
				animation: glitch 3s infinite;
			}

			@keyframes glitch {
				0%, 95% { transform: translate(0); }
				96% { transform: translate(2px, 1px); }
				97% { transform: translate(-1px, -1px); }
				98% { transform: translate(1px, 2px); }
				99% { transform: translate(-2px, -1px); }
			}

			.subtitle {
				font-size: 1rem;
				color: var(--neon-yellow);
				margin-top: 20px;
				animation: float 2s ease-in-out infinite alternate;
			}

			@keyframes float {
				from { transform: translateY(0px); }
				to { transform: translateY(-10px); }
			}

			.projects-container {
				position: relative;
				min-height: 450px;
			}

			.project {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				opacity: 0;
				transform: translateX(100px);
				transition: all 0.5s ease;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 40px;
				pointer-events: none;
			}

			.project.active {
				opacity: 1;
				transform: translateX(0);
				pointer-events: auto;
			}

			.project-header {
				text-align: center;
			}

			.level-indicator {
				font-size: 1.5rem;
				color: var(--neon-cyan);
				display: block;
				margin-bottom: 20px;
				text-shadow: 0 0 10px var(--neon-cyan);
			}

			.project-sprite {
				font-size: 6rem;
				filter: drop-shadow(0 0 20px var(--neon-yellow));
				animation: bounce 2s ease-in-out infinite;
			}

			@keyframes bounce {
				0%, 100% { transform: translateY(0px); }
				50% { transform: translateY(-20px); }
			}

			.dialog-box {
				background: linear-gradient(135deg, rgba(0, 20, 40, 0.9), rgba(0, 8, 20, 0.9));
				border: 4px solid var(--neon-green);
				border-radius: 15px;
				padding: 30px;
				max-width: 500px;
				box-shadow: 
					0 0 20px rgba(0, 255, 65, 0.3),
					inset 0 0 20px rgba(0, 255, 65, 0.1);
				position: relative;
			}

			.dialog-box::before {
				content: '';
				position: absolute;
				top: -10px;
				left: 30px;
				width: 0;
				height: 0;
				border-left: 10px solid transparent;
				border-right: 10px solid transparent;
				border-bottom: 10px solid var(--neon-green);
			}

			.dialog-header {
				border-bottom: 2px solid var(--neon-green);
				padding-bottom: 15px;
				margin-bottom: 20px;
			}

			.project-title {
				font-size: 1.2rem;
				color: var(--neon-green);
				text-shadow: 0 0 10px var(--neon-green);
			}

			.dialog-content p {
				font-size: 0.8rem;
				line-height: 1.6;
				color: #ccc;
				margin-bottom: 20px;
			}

			.project-links {
				display: flex;
				gap: 10px;
				margin-bottom: 20px;
			}

			.project-link {
				padding: 10px 15px;
				font-size: 0.7rem;
				border-radius: 8px;
				border: 2px solid var(--neon-cyan);
				background: rgba(0, 255, 255, 0.1);
				color: var(--neon-cyan);
				text-decoration: none;
				text-shadow: 0 0 5px var(--neon-cyan);
				box-shadow: 0 0 10px rgba(0, 255, 255, 0.3);
				transition: all 0.3s ease;
				display: inline-block;
			}

			.project-link:hover {
				background: rgba(0, 255, 255, 0.2);
				box-shadow: 0 0 20px rgba(0, 255, 255, 0.6);
				transform: translateY(-2px);
			}

			.project-link.demo {
				border-color: var(--neon-magenta);
				color: var(--neon-magenta);
				text-shadow: 0 0 5px var(--neon-magenta);
				box-shadow: 0 0 10px rgba(255, 0, 128, 0.3);
			}

			.project-link.demo:hover {
				background: rgba(255, 0, 128, 0.2);
				box-shadow: 0 0 20px rgba(255, 0, 128, 0.6);
			}

			.tech-badges {
				display: flex;
				gap: 10px;
				flex-wrap: wrap;
			}

			.badge {
				padding: 8px 12px;
				font-size: 0.7rem;
				border-radius: 8px;
				border: 2px solid;
				background: rgba(0, 0, 0, 0.8);
				text-shadow: 0 0 5px currentColor;
				box-shadow: 0 0 10px currentColor;
				animation: glow 2s ease-in-out infinite alternate;
			}

			.badge.js { color: var(--neon-yellow); border-color: var(--neon-yellow); }
			.badge.canvas { color: var(--neon-magenta); border-color: var(--neon-magenta); }
			.badge.webgl { color: var(--neon-cyan); border-color: var(--neon-cyan); }
			.badge.react { color: var(--neon-cyan); border-color: var(--neon-cyan); }
			.badge.node { color: var(--neon-green); border-color: var(--neon-green); }
			.badge.mongo { color: var(--neon-green); border-color: var(--neon-green); }
			.badge.flutter { color: var(--neon-cyan); border-color: var(--neon-cyan); }
			.badge.firebase { color: var(--neon-magenta); border-color: var(--neon-magenta); }
			.badge.api { color: var(--neon-cyan); border-color: var(--neon-cyan); }
			.badge.python { color: var(--neon-green); border-color: var(--neon-green); }
			.badge.ai { color: var(--neon-magenta); border-color: var(--neon-magenta); }
			.badge.docker { color: var(--neon-cyan); border-color: var(--neon-cyan); }
			.badge.vue { color: var(--neon-green); border-color: var(--neon-green); }
			.badge.postgres { color: var(--neon-cyan); border-color: var(--neon-cyan); }
			.badge.solidity { color: var(--neon-yellow); border-color: var(--neon-yellow); }
			.badge.web3 { color: var(--neon-magenta); border-color: var(--neon-magenta); }
			.badge.next { color: var(--neon-cyan); border-color: var(--neon-cyan); }

			@keyframes glow {
				from { box-shadow: 0 0 5px currentColor; }
				to { box-shadow: 0 0 20px currentColor, 0 0 30px currentColor; }
			}

			.controls {
				padding: 30px;
				display: flex;
				justify-content: space-between;
				align-items: center;
				background: rgba(0, 0, 0, 0.3);
				border-top: 2px solid #333;
			}

			.progress-bar {
				display: flex;
				align-items: center;
				gap: 15px;
			}

			.progress-label {
				font-size: 0.8rem;
				color: var(--neon-cyan);
			}

			.progress-container {
				width: 200px;
				height: 20px;
				background: #333;
				border: 2px solid var(--neon-cyan);
				border-radius: 10px;
				overflow: hidden;
			}

			.progress-fill {
				height: 100%;
				width: 16.66%;
				background: linear-gradient(90deg, var(--neon-green), var(--neon-cyan));
				border-radius: 8px;
				transition: width 0.5s ease;
				box-shadow: 0 0 10px var(--neon-green);
			}

			.digital-display {
				font-size: 1.5rem;
				color: var(--neon-green);
				background: #000;
				padding: 15px 25px;
				border: 3px solid var(--neon-green);
				border-radius: 10px;
				text-shadow: 0 0 10px var(--neon-green);
				box-shadow: 
					0 0 20px rgba(0, 255, 65, 0.3),
					inset 0 0 10px rgba(0, 255, 65, 0.1);
			}

			.separator {
				animation: blink 1s infinite;
			}

			@keyframes blink {
				0%, 50% { opacity: 1; }
				51%, 100% { opacity: 0.3; }
			}

			.nav-buttons {
				display: flex;
				gap: 20px;
			}

			.nav-btn {
				width: 80px;
				height: 80px;
				background: linear-gradient(145deg, #2a2a2a, #1a1a1a);
				border: 4px solid var(--neon-magenta);
				border-radius: 50%;
				color: var(--neon-magenta);
				font-size: 2rem;
				cursor: pointer;
				transition: all 0.2s ease;
				box-shadow: 
					0 8px 16px rgba(0, 0, 0, 0.3),
					0 0 20px rgba(255, 0, 128, 0.3),
					inset 0 0 10px rgba(255, 0, 128, 0.1);
			}

			.nav-btn:hover:not(:disabled) {
				transform: translateY(-3px) scale(1.05);
				box-shadow: 
					0 12px 24px rgba(0, 0, 0, 0.4),
					0 0 30px rgba(255, 0, 128, 0.6),
					inset 0 0 15px rgba(255, 0, 128, 0.2);
			}

			.nav-btn:active {
				transform: translateY(2px) scale(0.95);
			}

			.nav-btn:disabled {
				opacity: 0.3;
				cursor: not-allowed;
				transform: none;
			}

			@media (max-width: 768px) {
				.console {
					width: 98%;
					border-width: 4px;
				}
				
				.glitch-title {
					font-size: 1.8rem;
				}
				
				.subtitle {
					font-size: 0.8rem;
				}
				
				.project {
					flex-direction: column;
					gap: 20px;
				}
				
				.project-sprite {
					font-size: 4rem;
				}
				
				.dialog-box {
					padding: 20px;
				}
				
				.controls {
					flex-direction: column;
					gap: 20px;
					padding: 20px;
				}
				
				.nav-btn {
					width: 60px;
					height: 60px;
					font-size: 1.5rem;
				}
				
				.progress-container {
					width: 150px;
				}
			}
		</style>
	</head>
	<body>
		<div class="retro-grid"></div>
		<div class="stars-container" id="stars"></div>
		<div class="scanlines"></div>
		
		<Header />
		
		<div class="portfolio-wrapper">
			<div class="console">
				<div class="console-leds">
					<div class="led led-power"></div>
					<div class="led led-data"></div>
					<div class="led led-system"></div>
				</div>
				
				<div class="screen">
					<div class="screen-content">
						<div class="title-section">
							<h1 class="glitch-title">ALAN'S PORTFOLIO</h1>
							<p class="subtitle">&gt;&gt;&gt; LEVEL SELECT &lt;&lt;&lt;</p>
						</div>
						
						<div class="projects-container">
							{projects.map((project, index) => (
								<div class={`project ${index === 0 ? 'active' : ''}`} data-level={project.level}>
									<div class="project-header">
										<span class="level-indicator">LVL {String(project.level).padStart(2, '0')}</span>
										<div class="project-sprite">{project.emoji}</div>
									</div>
									<div class="dialog-box">
										<div class="dialog-header">
											<span class="project-title">{project.title}</span>
										</div>
										<div class="dialog-content">
											<p>{project.description}</p>
											
											{project.links && (
												<div class="project-links">
													{project.links.demo && (
														<a href={project.links.demo} target="_blank" rel="noopener noreferrer" class="project-link demo">
															▶ DEMO
														</a>
													)}
													{project.links.github && (
														<a href={project.links.github} target="_blank" rel="noopener noreferrer" class="project-link">
															⚙ CODE
														</a>
													)}
													{project.links && 'case' in project.links && project.links.case && (
														<a href={String(project.links.case)} target="_blank" rel="noopener noreferrer" class="project-link">
															📄 CASE
														</a>
													)}
												</div>
											)}
											
											<div class="tech-badges">
												{project.techs.map(tech => (
													<span class={`badge ${tech.class}`}>{tech.name}</span>
												))}
											</div>
										</div>
									</div>
								</div>
							))}
						</div>
					</div>
				</div>
				
				<div class="controls">
					<div class="progress-bar">
						<div class="progress-label">PROGRESS</div>
						<div class="progress-container">
							<div class="progress-fill" id="progressFill"></div>
						</div>
					</div>
					
					<div class="digital-display">
						<span class="current-page">01</span>
						<span class="separator">/</span>
						<span class="total-pages">{String(totalProjects).padStart(2, '0')}</span>
					</div>
					
					<div class="nav-buttons">
						<button class="nav-btn" id="prevBtn">
							<span class="btn-icon">◄</span>
						</button>
						<button class="nav-btn" id="nextBtn">
							<span class="btn-icon">►</span>
						</button>
					</div>
				</div>
			</div>
		</div>
		
		<Footer />
		
		<script define:vars={{ totalProjects }}>
			class RetroPortfolio {
				constructor() {
					this.currentProject = 0;
					this.totalProjects = totalProjects;
					this.projects = document.querySelectorAll('.project');
					this.prevBtn = document.getElementById('prevBtn');
					this.nextBtn = document.getElementById('nextBtn');
					this.progressFill = document.getElementById('progressFill');
					this.currentPageDisplay = document.querySelector('.current-page');
					
					this.init();
					this.createStars();
					this.bindEvents();
				}
				
				init() {
					this.updateDisplay();
					this.updateButtons();
				}
				
				createStars() {
					const starsContainer = document.getElementById('stars');
					for (let i = 0; i < 20; i++) {
						const star = document.createElement('div');
						star.style.cssText = `
							position: absolute;
							width: ${Math.random() * 3 + 1}px;
							height: ${Math.random() * 3 + 1}px;
							background: var(--neon-yellow);
							border-radius: 50%;
							top: ${Math.random() * 100}%;
							left: ${Math.random() * 100}%;
							animation: pulse ${Math.random() * 3 + 1}s infinite;
							animation-delay: ${Math.random() * 2}s;
							box-shadow: 0 0 6px var(--neon-yellow);
						`;
						starsContainer.appendChild(star);
					}
				}
				
				bindEvents() {
					this.prevBtn.addEventListener('click', () => this.navigate(-1));
					this.nextBtn.addEventListener('click', () => this.navigate(1));
					
					document.addEventListener('keydown', (e) => {
						if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {
							e.preventDefault();
							this.navigate(-1);
						}
						if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
							e.preventDefault();
							this.navigate(1);
						}
					});
					
					// Touch events para móviles
					let touchStartX = 0;
					const screen = document.querySelector('.screen');
					
					screen.addEventListener('touchstart', (e) => {
						touchStartX = e.changedTouches[0].screenX;
					});
					
					screen.addEventListener('touchend', (e) => {
						const diff = touchStartX - e.changedTouches[0].screenX;
						if (Math.abs(diff) > 50) {
							this.navigate(diff > 0 ? 1 : -1);
						}
					});
				}
				
				navigate(direction) {
					const newIndex = this.currentProject + direction;
					if (newIndex >= 0 && newIndex < this.totalProjects) {
						this.projects[this.currentProject].classList.remove('active');
						this.currentProject = newIndex;
						
						setTimeout(() => {
							this.projects[this.currentProject].classList.add('active');
						}, 150);
						
						this.updateDisplay();
						this.updateButtons();
						this.triggerScreenEffect();
						
						if (navigator.vibrate) navigator.vibrate(50);
					}
				}
				
				updateDisplay() {
					this.currentPageDisplay.textContent = String(this.currentProject + 1).padStart(2, '0');
					const progress = ((this.currentProject + 1) / this.totalProjects) * 100;
					this.progressFill.style.width = progress + '%';
				}
				
				updateButtons() {
					this.prevBtn.disabled = this.currentProject === 0;
					this.nextBtn.disabled = this.currentProject === this.totalProjects - 1;
				}
				
				triggerScreenEffect() {
					const screen = document.querySelector('.screen');
					screen.style.filter = 'brightness(1.5) contrast(1.2)';
					setTimeout(() => {
						screen.style.filter = 'brightness(1) contrast(1)';
					}, 100);
				}
			}
			
			document.addEventListener('DOMContentLoaded', () => {
				new RetroPortfolio();
				
				// Efecto glitch aleatorio en el título
				setInterval(() => {
					if (Math.random() < 0.3) {
						const title = document.querySelector('.glitch-title');
						title.style.filter = 'hue-rotate(180deg)';
						setTimeout(() => {
							title.style.filter = '';
						}, 500);
					}
				}, 10000);
			});
		</script>
	</body>
</html>