---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<BaseHead title="About Alan Ugarte - Full Stack Developer" description="Learn about Alan Ugarte's journey as a Full Stack Developer specializing in Laravel, Angular, and NoSQL databases" />
		<!-- Import Press Start 2P font for consistency -->
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
		<style>
			/* Apply same retro background as homepage */
			body {
				background: 
					linear-gradient(45deg, #0f0f23 25%, transparent 25%), 
					linear-gradient(-45deg, #0f0f23 25%, transparent 25%), 
					linear-gradient(45deg, transparent 75%, #0f0f23 75%), 
					linear-gradient(-45deg, transparent 75%, #0f0f23 75%),
					linear-gradient(to bottom, #1a1a3a, #0f0f23);
				background-size: 20px 20px, 20px 20px, 20px 20px, 20px 20px, 100% 100%;
				background-position: 0 0, 0 10px, 10px -10px, -10px 0px, 0 0;
				color: #00ff41;
				font-family: 'Press Start 2P', monospace;
				min-height: 100vh;
				position: relative;
				overflow-x: hidden;
			}

			/* CRT scanlines effect */
			body::before {
				content: '';
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: repeating-linear-gradient(
					0deg,
					transparent,
					transparent 2px,
					rgba(0, 255, 65, 0.03) 2px,
					rgba(0, 255, 65, 0.03) 4px
				);
				pointer-events: none;
				z-index: 1000;
			}

			/* Main about container */
			.pixel-about {
				position: relative;
				padding: 2rem;
				max-width: 1000px;
				margin: 2rem auto;
			}

			/* About sections */
			.about-section {
				background: rgba(0, 0, 0, 0.4);
				border: 3px solid #330ce2;
				margin-bottom: 2rem;
				padding: 2rem;
				position: relative;
				box-shadow: 
					0 0 30px rgba(51, 12, 226, 0.3),
					inset 0 0 30px rgba(206, 205, 209, 0.1);
			}

			/* Rainbow border for sections */
			.about-section::before {
				content: '';
				position: absolute;
				top: -3px;
				left: -3px;
				right: -3px;
				bottom: -3px;
				background: linear-gradient(
					45deg,
					#ff0080, #141515, #0080ff, #ff0080
				);
				z-index: -1;
				animation: rainbow-border 3s linear infinite;
			}

			@keyframes rainbow-border {
				0% { background-position: 0% 50%; }
				50% { background-position: 100% 50%; }
				100% { background-position: 0% 50%; }
			}

			/* Section titles */
			.section-title {
				font-size: 1.5rem;
				color: #000000;
				margin-bottom: 1.5rem;
				text-align: center;
				text-shadow: 
					0 0 5px #6b17b4,
					0 0 10px #2429c8;
				animation: glitch 2s infinite;
			}

			/* Main title */
			.main-title {
				font-size: 2.5rem;
				color: #b020b5;
				text-align: center;
				margin-bottom: 3rem;
				text-shadow: 
					0 0 5px #00ff41,
					0 0 10px #00ff41,
					0 0 15px #00ff41;
				animation: glitch 2s infinite;
			}

			/* Glitch animation */
			@keyframes glitch {
				0%, 100% {
					text-shadow: 
						0 0 5px #00ff41,
						0 0 10px #00ff41,
						0 0 15px #00ff41;
				}
				25% {
					text-shadow: 
						-2px 0 #ff0080,
						2px 0 #0080ff,
						0 0 5px #00ff41;
				}
				50% {
					text-shadow: 
						2px 0 #ff0080,
						-2px 0 #0080ff,
						0 0 5px #00ff41;
				}
				75% {
					text-shadow: 
						0 0 5px #00ff41,
						0 0 10px #00ff41,
						0 0 15px #00ff41;
				}
			}

			/* Content text */
			.pixel-text {
				color: #f6f6f6;
				font-size: 0.8rem;
				line-height: 1.8;
				margin-bottom: 1.5rem;
				text-shadow: 1px 1px 0 #000000;
			}

			/* Timeline container */
			.timeline {
				position: relative;
				padding-left: 2rem;
			}

			.timeline::before {
				content: '';
				position: absolute;
				left: 0;
				top: 0;
				bottom: 0;
				width: 3px;
				background: linear-gradient(to bottom, #ff0080, #00ff41, #0080ff);
				border-radius: 2px;
			}

			/* Timeline items */
			.timeline-item {
				position: relative;
				margin-bottom: 2rem;
				padding-left: 2rem;
			}

			.timeline-item::before {
				content: '';
				position: absolute;
				left: -2rem;
				top: 0.5rem;
				width: 12px;
				height: 12px;
				background: #00ff41;
				border: 2px solid #ff0080;
				border-radius: 50%;
				box-shadow: 0 0 10px #00ff41;
			}

			.timeline-date {
				color: #0080ff;
				font-size: 0.7rem;
				font-weight: bold;
				margin-bottom: 0.5rem;
				text-shadow: 1px 1px 0 #004080;
			}

			.timeline-title {
				color: #00ff41;
				font-size: 0.9rem;
				margin-bottom: 0.5rem;
				text-shadow: 1px 1px 0 #00aa2e;
			}

			.timeline-desc {
				color: #f9f9f9;
				font-size: 0.7rem;
				line-height: 1.6;
				text-shadow: 1px 1px 0 #080708;
			}

			/* Skills grid */
			.skills-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 1rem;
				margin-top: 1rem;
			}

			.skill-category {
				background: rgba(0, 0, 0, 0.6);
				border: 2px solid #ff0080;
				padding: 1rem;
				text-align: center;
				transition: all 0.3s ease;
			}

			.skill-category:hover {
				border-color: #00ff41;
				box-shadow: 0 0 15px rgba(0, 255, 65, 0.5);
				transform: translateY(-2px);
			}

			.skill-title {
				color: #fbfbfb;
				font-size: 0.8rem;
				margin-bottom: 1rem;
				text-shadow: 1px 1px 0 #050505;
			}

			.skill-list {
				color: #eae7e9;
				font-size: 0.6rem;
				line-height: 1.8;
				text-shadow: 1px 1px 0 #000000;
			}

			/* Responsive design */
			@media (max-width: 768px) {
				.main-title {
					font-size: 1.8rem;
				}
				.section-title {
					font-size: 1.2rem;
				}
				.pixel-about {
					margin: 1rem;
					padding: 1rem;
				}
				.about-section {
					padding: 1.5rem;
				}
				.skills-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<div class="flex flex-col min-h-screen">
			<Header />
			
				<main class="flex-1 px-4 py-8">
					<div class="pixel-about">
						<h1 class="main-title" data-i18n="about.mainTitle">👨‍💻 PLAYER PROFILE</h1>
						
						<!-- Introduction Section -->
						<section class="about-section">
							<h2 class="section-title" data-i18n="about.missionTitle">🎯 MISSION STATEMENT</h2>
							<p class="pixel-text" data-i18n="about.missionP1">
								¡Hola! I'm Alan Ugarte, a passionate Full Stack Developer with over 5 years of professional experience crafting digital solutions. My journey began at age 15 with my first line of C++, and since then, I've been on an epic quest to master the art of programming.
							</p>
							<p class="pixel-text" data-i18n="about.missionP2">
								I specialize in building scalable web applications using modern technologies, with a strong focus on Laravel 11 backends, Angular 19 frontends, and NoSQL databases. My mission is to transform complex business requirements into elegant, efficient, and user-friendly solutions.
							</p>
						</section>

						<!-- Experience Timeline -->
						<section class="about-section">
							<h2 class="section-title" data-i18n="about.experienceTitle">🚀 EXPERIENCE LOG</h2>
							<div class="timeline">
								<div class="timeline-item">
									<div class="timeline-date" data-i18n="about.exp1.date">2024 - PRESENT</div>
									<div class="timeline-title" data-i18n="about.exp1.title">Freelancer</div>
									<div class="timeline-desc" data-i18n="about.exp1.desc">
										Currently developing and maintaining web applications with Python, React, and diverse databases. Leading projects end-to-end with a focus on performance, scalability, and user experience.
									</div>
								</div>
								<div class="timeline-item">
									<div class="timeline-date" data-i18n="about.exp2.date">2024</div>
									<div class="timeline-title" data-i18n="about.exp2.title">Geem Solutions</div>
									<div class="timeline-desc" data-i18n="about.exp2.desc">
										Full Stack Developer for point-of-sale systems using PHP and React. Enhanced application performance and user experience through modern development practices.
									</div>
								</div>
								<div class="timeline-item">
									<div class="timeline-date" data-i18n="about.exp3.date">2023 - 2024</div>
									<div class="timeline-title" data-i18n="about.exp3.title">Magmalabs</div>
									<div class="timeline-desc" data-i18n="about.exp3.desc">
										Began my professional journey as a Full Stack Developer. Contributed to projects like Bright Coders and Magma Chat, working with Python and React to deliver robust web applications.
									</div>
								</div>
							</div>
						</section>

						<!-- Technical Skills -->
						<section class="about-section">
							<h2 class="section-title" data-i18n="about.skillsTitle">⚡ TECH ARSENAL</h2>
							<div class="skills-grid">
								<div class="skill-category">
									<div class="skill-title" data-i18n="about.skill.backend">🖥️ BACKEND</div>
									<div class="skill-list">
										PHP 8.2<br/>
										Laravel 11<br/>
									Node.js<br/>
									RESTful APIs<br/>
									GraphQL
									</div>
								</div>
								<div class="skill-category">
									<div class="skill-title" data-i18n="about.skill.frontend">🎨 FRONTEND</div>
									<div class="skill-list">
										TypeScript 5.0<br/>
										Angular 19<br/>
									JavaScript ES6+<br/>
									HTML5 & CSS3<br/>
									Tailwind CSS
									</div>
								</div>
								<div class="skill-category">
									<div class="skill-title" data-i18n="about.skill.databases">🗄️ DATABASES</div>
									<div class="skill-list">
										MongoDB<br/>
										Firebase Firestore<br/>
									DynamoDB<br/>
									MySQL<br/>
									Redis
									</div>
								</div>
								<div class="skill-category">
									<div class="skill-title" data-i18n="about.skill.tools">🛠️ TOOLS & OTHERS</div>
									<div class="skill-list">
										Git & GitHub<br/>
										Docker<br/>
									AWS Services<br/>
									Agile/Scrum<br/>
									CI/CD
								</div>
							</div>
						</div>
					</section>

						<!-- Philosophy & Interests -->
						<section class="about-section">
							<h2 class="section-title" data-i18n="about.philosophyTitle">💡 CODING PHILOSOPHY</h2>
							<p class="pixel-text" data-i18n="about.philosophyP1">
								I believe in writing clean, maintainable code that not only solves problems but also tells a story. My approach combines modern development practices with a deep understanding of business requirements to deliver solutions that truly matter.
							</p>
							<p class="pixel-text" data-i18n="about.philosophyP2">
								When I'm not coding, you'll find me contributing to open-source projects, participating in hackathons, mentoring junior developers, or exploring the latest industry trends. I'm passionate about sharing knowledge and believe that the best way to grow is by helping others succeed.
							</p>
							<p class="pixel-text" data-i18n="about.philosophyP3">
								Currently focused on mastering Laravel 11's latest features, exploring Angular 19's new capabilities, and diving deeper into NoSQL database optimization techniques.
							</p>
						</section>
					</div>
				</main>
			
				<Footer />
			</div>
			<script is:inline>
				(() => {
					const root = document.querySelector('.pixel-about');
					const languageApi = window.portfolioLanguage;
					if (!root || !languageApi) return;

					const translations = {
						es: {
							'about.mainTitle': '👨‍💻 PERFIL DEL PLAYER',
							'about.missionTitle': '🎯 MISION',
							'about.missionP1': 'Hola, soy Alan Ugarte, un Full Stack Developer apasionado con mas de 5 anos de experiencia profesional creando soluciones digitales. Mi camino comenzo a los 15 anos con mi primera linea de C++, y desde entonces he estado en una mision constante para dominar el arte de programar.',
							'about.missionP2': 'Me especializo en construir aplicaciones web escalables usando tecnologias modernas, con enfoque en backends con Laravel 11, frontends con Angular 19 y bases de datos NoSQL. Mi objetivo es transformar requerimientos de negocio complejos en soluciones elegantes, eficientes y faciles de usar.',
							'about.experienceTitle': '🚀 EXPERIENCIA',
							'about.exp1.date': '2024 - ACTUALIDAD',
							'about.exp1.title': 'Freelancer',
							'about.exp1.desc': 'Actualmente desarrollo y mantengo aplicaciones web con Python, React y diversas bases de datos. Lidero proyectos de extremo a extremo con foco en rendimiento, escalabilidad y experiencia de usuario.',
							'about.exp2.date': '2024',
							'about.exp2.title': 'Geem Solutions',
							'about.exp2.desc': 'Full Stack Developer para sistemas punto de venta con PHP y React. Mejore el rendimiento de las aplicaciones y la experiencia de usuario mediante practicas modernas de desarrollo.',
							'about.exp3.date': '2023 - 2024',
							'about.exp3.title': 'Magmalabs',
							'about.exp3.desc': 'Inicie mi trayectoria profesional como Full Stack Developer. Contribui en proyectos como Bright Coders y Magma Chat, trabajando con Python y React para entregar aplicaciones web robustas.',
							'about.skillsTitle': '⚡ ARSENAL TECNICO',
							'about.skill.backend': '🖥️ BACKEND',
							'about.skill.frontend': '🎨 FRONTEND',
							'about.skill.databases': '🗄️ BASES DE DATOS',
							'about.skill.tools': '🛠️ HERRAMIENTAS Y OTROS',
							'about.philosophyTitle': '💡 FILOSOFIA DE CODIGO',
							'about.philosophyP1': 'Creo en escribir codigo limpio y mantenible que no solo resuelva problemas, sino que tambien cuente una historia. Mi enfoque combina practicas modernas de desarrollo con una comprension profunda del negocio para entregar soluciones que realmente importan.',
							'about.philosophyP2': 'Cuando no estoy programando, participo en proyectos open source, hackathons, mentoring a desarrolladores junior o explorando nuevas tendencias del sector. Me apasiona compartir conocimiento y creo que la mejor forma de crecer es ayudar a otros a crecer.',
							'about.philosophyP3': 'Actualmente estoy enfocado en dominar las ultimas funcionalidades de Laravel 11, explorar nuevas capacidades de Angular 19 y profundizar en tecnicas de optimizacion para bases de datos NoSQL.'
						},
						en: {
							'about.mainTitle': '👨‍💻 PLAYER PROFILE',
							'about.missionTitle': '🎯 MISSION STATEMENT',
							'about.missionP1': "Hello, I'm Alan Ugarte, a passionate Full Stack Developer with over 5 years of professional experience crafting digital solutions. My journey began at age 15 with my first line of C++, and since then, I have been on an ongoing quest to master the art of programming.",
							'about.missionP2': 'I specialize in building scalable web applications using modern technologies, with a strong focus on Laravel 11 backends, Angular 19 frontends, and NoSQL databases. My mission is to transform complex business requirements into elegant, efficient, and user-friendly solutions.',
							'about.experienceTitle': '🚀 EXPERIENCE LOG',
							'about.exp1.date': '2024 - PRESENT',
							'about.exp1.title': 'Freelancer',
							'about.exp1.desc': 'Currently developing and maintaining web applications with Python, React, and diverse databases. Leading projects end-to-end with a focus on performance, scalability, and user experience.',
							'about.exp2.date': '2024',
							'about.exp2.title': 'Geem Solutions',
							'about.exp2.desc': 'Full Stack Developer for point-of-sale systems using PHP and React. Enhanced application performance and user experience through modern development practices.',
							'about.exp3.date': '2023 - 2024',
							'about.exp3.title': 'Magmalabs',
							'about.exp3.desc': 'Began my professional journey as a Full Stack Developer. Contributed to projects like Bright Coders and Magma Chat, working with Python and React to deliver robust web applications.',
							'about.skillsTitle': '⚡ TECH ARSENAL',
							'about.skill.backend': '🖥️ BACKEND',
							'about.skill.frontend': '🎨 FRONTEND',
							'about.skill.databases': '🗄️ DATABASES',
							'about.skill.tools': '🛠️ TOOLS & OTHERS',
							'about.philosophyTitle': '💡 CODING PHILOSOPHY',
							'about.philosophyP1': 'I believe in writing clean, maintainable code that not only solves problems but also tells a story. My approach combines modern development practices with a deep understanding of business requirements to deliver solutions that truly matter.',
							'about.philosophyP2': "When I am not coding, you will find me contributing to open-source projects, participating in hackathons, mentoring junior developers, or exploring the latest industry trends. I am passionate about sharing knowledge and believe that the best way to grow is by helping others succeed.",
							'about.philosophyP3': "Currently focused on mastering Laravel 11's latest features, exploring Angular 19's new capabilities, and diving deeper into NoSQL database optimization techniques."
						}
					};

					const pageTitles = {
						es: 'Sobre Alan Ugarte - Full Stack Developer',
						en: 'About Alan Ugarte - Full Stack Developer'
					};

					const render = (lang) => {
						languageApi.applyTranslations(root, translations, lang);
						document.title = pageTitles[lang] || pageTitles.en;
					};

					render(languageApi.getLang());
					window.addEventListener('portfolio-lang-change', (event) => {
						render(event.detail);
					});
				})();
			</script>
		</body>
</html>
