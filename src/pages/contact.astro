---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLang } from '../utils/i18n';

const lang = getLang(Astro.url);
---

<html lang={lang}>
  <head>
    <BaseHead title="Contact - Alan Ugarte" description="Get in touch - Let's build something amazing together!" />
    <!-- Import Press Start 2P font for consistency -->
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <style>
      /* Apply same retro background as homepage */
      body {
        background: 
          linear-gradient(45deg, #0f0f23 25%, transparent 25%), 
          linear-gradient(-45deg, #0f0f23 25%, transparent 25%), 
          linear-gradient(45deg, transparent 75%, #0f0f23 75%), 
          linear-gradient(-45deg, transparent 75%, #0f0f23 75%),
          linear-gradient(to bottom, #1a1a3a, #0f0f23);
        background-size: 20px 20px, 20px 20px, 20px 20px, 20px 20px, 100% 100%;
        background-position: 0 0, 0 10px, 10px -10px, -10px 0px, 0 0;
        color: #00ff41;
        font-family: 'Press Start 2P', monospace;
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
      }

      /* CRT scanlines effect */
      body::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(0, 255, 65, 0.03) 2px,
          rgba(0, 255, 65, 0.03) 4px
        );
        pointer-events: none;
        z-index: 1000;
      }

      /* Contact form container */
      .pixel-contact-form {
        position: relative;
        padding: 3rem 2rem;
        background: rgba(0, 0, 0, 0.4);
        border: 3px solid #00ff41;
        margin: 2rem auto;
        max-width: 600px;
        box-shadow: 
          0 0 30px rgba(0, 255, 65, 0.3),
          inset 0 0 30px rgba(0, 255, 65, 0.1);
      }

      /* Rainbow border animation */
      .pixel-contact-form::before {
        content: '';
        position: absolute;
        top: -3px;
        left: -3px;
        right: -3px;
        bottom: -3px;
        background: linear-gradient(
          45deg,
          #ff0080, #0b0e0c, #0080ff, #ff0080
        );
        z-index: -1;
        animation: rainbow-border 3s linear infinite;
      }

      @keyframes rainbow-border {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }

      /* Form title */
      .contact-title {
        font-size: 2rem;
        color: #00ff41;
        text-align: center;
        margin-bottom: 2rem;
        text-shadow: 
          0 0 5px #00ff41,
          0 0 10px #00ff41,
          0 0 15px #00ff41;
        animation: glitch 2s infinite;
      }

      /* Glitch animation for title */
      @keyframes glitch {
        0%, 100% {
          text-shadow: 
            0 0 5px #00ff41,
            0 0 10px #00ff41,
            0 0 15px #00ff41;
        }
        25% {
          text-shadow: 
            -2px 0 #ff0080,
            2px 0 #0080ff,
            0 0 5px #00ff41;
        }
        50% {
          text-shadow: 
            2px 0 #ff0080,
            -2px 0 #0080ff,
            0 0 5px #00ff41;
        }
        75% {
          text-shadow: 
            0 0 5px #00ff41,
            0 0 10px #00ff41,
            0 0 15px #00ff41;
        }
      }

      /* Form labels */
      .pixel-label {
        display: block;
        margin-bottom: 0.5rem;
        color: #ff0080;
        font-size: 0.8rem;
        text-transform: uppercase;
        text-shadow: 1px 1px 0 #aa0055;
      }

      /* Form inputs */
      .pixel-input {
        width: 100%;
        padding: 1rem;
        background: rgba(0, 0, 0, 0.6);
        border: 2px solid #00ff41;
        color: #00ff41;
        font-family: 'Press Start 2P', monospace;
        font-size: 0.7rem;
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
      }

      .pixel-input:focus {
        outline: none;
        border-color: #ff0080;
        box-shadow: 0 0 15px rgba(255, 0, 128, 0.5);
        color: #ff0080;
      }

      .pixel-input::placeholder {
        color: rgba(0, 255, 65, 0.5);
        font-family: 'Press Start 2P', monospace;
        font-size: 0.6rem;
      }

      /* Submit button */
      .pixel-submit {
        width: 100%;
        padding: 1rem 2rem;
        border: 3px solid #00ff41;
        background: linear-gradient(45deg, #0f0f23, #1a1a3a);
        color: #00ff41;
        font-family: 'Press Start 2P', monospace;
        font-size: 0.8rem;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        box-shadow: 
          0 4px 0 #00aa2e,
          0 8px 15px rgba(0, 0, 0, 0.3);
      }

      .pixel-submit::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, 
          transparent,
          rgba(0, 255, 65, 0.2),
          transparent);
        transition: left 0.5s ease;
      }

      .pixel-submit:hover::before {
        left: 100%;
      }

      .pixel-submit:hover {
        background: linear-gradient(45deg, #00ff41, #00aa2e);
        color: #0f0f23;
        transform: translateY(-4px);
        box-shadow: 
          0 8px 0 #007a22,
          0 12px 20px rgba(0, 0, 0, 0.4),
          0 0 20px rgba(0, 255, 65, 0.5);
      }

      /* Calendly section */
      .pixel-calendly {
        margin-top: 3rem;
        text-align: center;
        padding-top: 2rem;
        border-top: 2px dashed #ff0080;
      }

      .calendly-text {
        color: #ff0080;
        margin-bottom: 1rem;
        font-size: 0.8rem;
        text-shadow: 1px 1px 0 #aa0055;
      }

      .pixel-calendly-btn {
        display: inline-block;
        padding: 1rem 2rem;
        border: 3px solid #ff0080;
        background: linear-gradient(45deg, #0f0f23, #1a1a3a);
        color: #ff0080;
        text-decoration: none;
        font-family: 'Press Start 2P', monospace;
        font-size: 0.7rem;
        text-transform: uppercase;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        box-shadow: 
          0 4px 0 #aa0055,
          0 8px 15px rgba(0, 0, 0, 0.3);
      }

      .pixel-calendly-btn:hover {
        background: linear-gradient(45deg, #ff0080, #aa0055);
        color: #0f0f23;
        transform: translateY(-4px);
        box-shadow: 
          0 8px 0 #77003d,
          0 12px 20px rgba(0, 0, 0, 0.4),
          0 0 20px rgba(255, 0, 128, 0.5);
      }

      /* Responsive design */
      @media (max-width: 768px) {
        .contact-title {
          font-size: 1.5rem;
        }
        .pixel-contact-form {
          margin: 1rem;
          padding: 2rem 1rem;
        }
        .pixel-input {
          font-size: 0.6rem;
        }
        .pixel-submit {
          font-size: 0.7rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- Main page layout -->
    <div class="flex flex-col min-h-screen">
      <Header />
      
      <main class="flex-1 flex items-center justify-center px-4">
        <div class="pixel-contact-form">
          <h1 class="contact-title">📧 CONTACT MISSION</h1>
          
          <form
            method="POST"
            action="https://formspree.io/f/mldbgzvv"
          >
            <div>
              <label class="pixel-label" for="name">
                🏷️ Player Name:
              </label>
              <input
                class="pixel-input"
                type="text"
                id="name"
                name="name"
                placeholder="Enter your name..."
                required
              />
            </div>
            
            <div>
              <label class="pixel-label" for="email">
                📧 Email Address:
              </label>
              <input
                class="pixel-input"
                type="email"
                id="email"
                name="email"
                placeholder="your.email@domain.com"
                required
              />
            </div>
            
            <div>
              <label class="pixel-label" for="message">
                💬 Mission Details:
              </label>
              <textarea
                class="pixel-input"
                id="message"
                name="message"
                rows="5"
                placeholder="Tell me about your project or idea..."
                required
              ></textarea>
            </div>
            
            <button class="pixel-submit" type="submit">
              🚀 Send Message
            </button>
          </form>

          <div class="pixel-calendly">
            <p class="calendly-text">🎮 Want to discuss your project directly?</p>
            <a
              href="https://calendly.com/alansaucedo-dev/30min"
              target="_blank"
              rel="noopener"
              class="pixel-calendly-btn"
            >
              📅 Schedule Call
            </a>
          </div>
        </div>
      </main>
      
      <Footer />
    </div>
  </body>
</html>
