---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectsShowcase from '../../components/ProjectsShowcase.astro';
import { getLang } from '../../utils/i18n';

const lang = getLang(Astro.url);

const copy = {
	es: {
		title: 'Proyectos | Alan Ugarte',
		description: 'Portafolio de proyectos con estilo azteca claro y vista bilingue.'
	},
	en: {
		title: 'Projects | Alan Ugarte',
		description: 'Project portfolio with a light Aztec style and bilingual view.'
	}
} as const;

const meta = copy[lang];
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={meta.title} description={meta.description} />
		<style>
			body {
				margin: 0;
				min-height: 100vh;
				background:
					radial-gradient(circle at 15% 15%, rgba(255, 216, 145, 0.25), transparent 45%),
					radial-gradient(circle at 88% 10%, rgba(47, 123, 106, 0.14), transparent 38%),
					linear-gradient(180deg, #fbf2de 0%, #f0deba 100%);
				color: #2e1f17;
				font-family: 'Manrope', 'Segoe UI', sans-serif;
			}

			main {
				width: 100%;
				max-width: 100%;
				padding: 1.25rem 0 2.4rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<ProjectsShowcase lang={lang} />
		</main>
		<Footer />
	</body>
</html>
